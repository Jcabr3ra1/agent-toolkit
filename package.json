{
  "name": "nexakit",
  "version": "0.1.0",
  "description": "Asistente por pasos de skills verificadas por SHA-256, coordinación entre agentes y memoria por proyecto para Claude Code y Codex.",
  "type": "module",
  "bin": {
    "nexakit": "./bin/nexakit.js",
    "agent-toolkit": "./bin/agent-toolkit.js",
    "project-memory": "./bin/project-memory.js",
    "agent-task": "./bin/agent-task.js",
    "agent-toolkit-mcp": "./bin/agent-toolkit-mcp.js",
    "agent-toolkit-inbox": "./bin/agent-toolkit-inbox.js",
    "project-memory-mcp": "./bin/project-memory-mcp.js",
    "agent-toolkit-gemini": "./bin/agent-toolkit-gemini.js"
  },
  "scripts": {
    "test": "node --test",
    "catalog:validate": "node scripts/validate-skill-catalog.js",
    "catalog:files": "node scripts/validate-skill-catalog.js --files",
    "prepack": "node scripts/prepare-package.js"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "@modelcontextprotocol/server": "^2.4.0",
    "@modelcontextprotocol/server-filesystem": "2026.8.31",
    "ajv": "^8.17.1",
    "eslint-visitor-keys": "5.0.1",
    "toml-eslint-parser": "1.0.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.4.0"
  },
  "license": "MIT",
  "keywords": [
    "ai-agents",
    "skills",
    "claude-code",
    "codex",
    "mcp",
    "project-memory",
    "nexakit"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Jcabr3ra1/agent-toolkit.git"
  },
  "files": [
    "bin/",
    "src/",
    "skills/",
    "catalogs/",
    "agents/",
    "plugins/",
    "schemas/",
    "templates/",
    ".claude-plugin/",
    ".claude/skills/",
    ".agents/skills/",
    "assets/brand/",
    "docs/skills/evidencias/",
    "assets/runtime/",
    "scripts/prepare-package.js",
    "scripts/validate-skill-catalog.js"
  ]
}
