{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-toolkit.local/schemas/agent-client-native-diagnostics.schema.json",
  "title": "S3.1 trusted native diagnostics, not inference admission",
  "$defs": {
    "pin": {
      "type": "object", "additionalProperties": false,
      "required": ["entryPath", "artifactPath", "expectedSha256", "expectedUid", "expectedMode", "expectedSize", "expectedDev", "expectedIno", "expectedLinkIno"],
      "properties": {
        "entryPath": {"type": "string", "minLength": 1, "maxLength": 4096},
        "artifactPath": {"type": "string", "minLength": 1, "maxLength": 4096},
        "expectedSha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "expectedUid": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
        "expectedMode": {"type": "integer", "minimum": 0, "maximum": 4095},
        "expectedSize": {"type": "integer", "minimum": 1, "maximum": 536870912},
        "expectedDev": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
        "expectedIno": {"type": "integer", "minimum": 1, "maximum": 9007199254740991},
        "expectedLinkIno": {"type": "integer", "minimum": 1, "maximum": 9007199254740991}
      }
    },
    "limits": {
      "type": "object", "additionalProperties": false,
      "required": ["maxStarts", "processTimeoutMs", "totalTimeoutMs", "graceMs", "confirmationMs", "maxStdoutBytes", "maxStderrBytes"],
      "properties": {
        "maxStarts": {"const": 2},
        "processTimeoutMs": {"type": "integer", "minimum": 100, "maximum": 15000},
        "totalTimeoutMs": {"type": "integer", "minimum": 100, "maximum": 90000},
        "graceMs": {"type": "integer", "minimum": 10, "maximum": 1000},
        "confirmationMs": {"type": "integer", "minimum": 10, "maximum": 1000},
        "maxStdoutBytes": {"type": "integer", "minimum": 1, "maximum": 131072},
        "maxStderrBytes": {"type": "integer", "minimum": 1, "maximum": 32768}
      }
    },
    "configuration": {
      "type": "object", "additionalProperties": false,
      "required": ["candidate", "workspaceParent", "limits"],
      "properties": {
        "candidate": {"$ref": "#/$defs/pin"},
        "workspaceParent": {"type": "string", "minLength": 1, "maxLength": 4096},
        "limits": {"$ref": "#/$defs/limits"}
      }
    },
    "reason": {"enum": ["diagnostic-completed", "diagnostic-configuration-invalid", "diagnostic-schema-invalid", "diagnostic-input-forbidden", "diagnostic-permit-unavailable", "diagnostic-platform-not-admitted", "diagnostic-canceled", "diagnostic-path-unsafe", "diagnostic-private-parent-unsafe", "diagnostic-artifact-changed", "diagnostic-artifact-limit", "diagnostic-artifact-unconfirmed", "diagnostic-deadline", "diagnostic-spawn-failed", "diagnostic-process-error", "diagnostic-output-limit", "diagnostic-stderr-limit", "diagnostic-invalid-utf8", "diagnostic-output-unexpected", "diagnostic-group-unconfirmed", "diagnostic-signal-unconfirmed", "diagnostic-termination-unconfirmed", "diagnostic-exit-failed", "diagnostic-workspace-cleanup-required", "diagnostic-local-error"]},
    "reasons": {"type": "array", "maxItems": 24, "uniqueItems": true, "items": {"$ref": "#/$defs/reason"}},
    "operation": {
      "type": "object", "additionalProperties": false,
      "required": ["recipe", "state", "spawnAttempts", "startObserved", "elapsedMs", "stdoutBytes", "stderrBytes", "terminationConfirmed", "reasons"],
      "properties": {
        "recipe": {"enum": ["version", "help"]},
        "state": {"enum": ["not-started", "completed", "failed", "canceled", "timed-out", "indeterminate"]},
        "spawnAttempts": {"type": "integer", "minimum": 0, "maximum": 1},
        "startObserved": {"type": "boolean"}, "terminationConfirmed": {"type": "boolean"},
        "elapsedMs": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
        "stdoutBytes": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
        "stderrBytes": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
        "reasons": {"$ref": "#/$defs/reasons"}
      }
    },
    "report": {
      "type": "object", "additionalProperties": false,
      "required": ["scope", "state", "nativeExecuted", "inferenceRequested", "actualModelCalls", "runtimeReady", "verifiedAdmission", "externalBillingVerified", "remoteCancellationVerified", "spawnAttempts", "startsObserved", "elapsedMs", "operations", "reasons"],
      "properties": {
        "scope": {"const": "native-diagnostics-only"},
        "state": {"enum": ["blocked", "completed", "failed", "canceled", "timed-out", "indeterminate"]},
        "nativeExecuted": {"type": "boolean"}, "inferenceRequested": {"const": false},
        "actualModelCalls": {"type": "null"}, "runtimeReady": {"const": false},
        "verifiedAdmission": {"const": false}, "externalBillingVerified": {"const": false},
        "remoteCancellationVerified": {"const": false},
        "spawnAttempts": {"type": "integer", "minimum": 0, "maximum": 2},
        "startsObserved": {"type": "integer", "minimum": 0, "maximum": 2},
        "elapsedMs": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
        "operations": {"type": "array", "maxItems": 2, "items": {"$ref": "#/$defs/operation"}},
        "reasons": {"$ref": "#/$defs/reasons"}
      }
    },
    "observation": {
      "type": "object", "additionalProperties": false,
      "required": ["declaredVersion", "optionsPresent"],
      "properties": {
        "declaredVersion": {"type": ["string", "null"], "pattern": "^\\d{1,4}\\.\\d{1,4}\\.\\d{1,4}(?:-[a-z0-9][a-z0-9.-]{0,31})?$"},
        "optionsPresent": {"type": "array", "maxItems": 17, "uniqueItems": true, "items": {"enum": ["--tools", "--disallowedTools", "--strict-mcp-config", "--mcp-config", "--safe-mode", "--restricted", "--setting-sources", "--settings", "--model", "--effort", "--max-turns", "--no-session-persistence", "--output-format", "--permission-prompts", "--disable-slash-commands", "--no-chrome", "--print"]}}
      }
    }
  }
}
