{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Agent Toolkit Codex planning result",
  "type": "object",
  "additionalProperties": false,
  "required": ["summary", "claude", "files", "acceptance", "checks"],
  "properties": {
    "summary": { "type": "string", "minLength": 1, "maxLength": 4000 },
    "claude": {
      "type": "object",
      "additionalProperties": false,
      "required": ["model", "effort"],
      "properties": {
        "model": { "type": "string", "minLength": 1, "maxLength": 80 },
        "effort": { "enum": ["low", "medium", "high", "xhigh", "max"] }
      }
    },
    "files": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "action", "reason"],
        "properties": {
          "path": { "type": "string", "minLength": 1, "maxLength": 512 },
          "action": { "enum": ["inspect", "modify", "create"] },
          "reason": { "type": "string", "minLength": 1, "maxLength": 1000 }
        }
      }
    },
    "acceptance": { "type": "array", "maxItems": 32, "items": { "type": "string", "minLength": 1, "maxLength": 1000 } },
    "checks": { "type": "array", "maxItems": 32, "items": { "type": "string", "minLength": 1, "maxLength": 1000 } }
  }
}
