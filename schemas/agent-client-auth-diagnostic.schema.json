{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-toolkit.local/schemas/agent-client-auth-diagnostic.schema.json",
  "$defs": {
    "parserLimits": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "maxBytes",
        "blockBytes",
        "maxDepth",
        "maxNodes",
        "maxKeyBytes",
        "maxKeys"
      ],
      "properties": {
        "maxBytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 32768
        },
        "blockBytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 32768
        },
        "maxDepth": {
          "type": "integer",
          "minimum": 1,
          "maximum": 32
        },
        "maxNodes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 20000
        },
        "maxKeyBytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 256
        },
        "maxKeys": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4096
        }
      }
    },
    "projection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "loggedIn",
        "authMethod",
        "subscriptionType",
        "classification"
      ],
      "properties": {
        "loggedIn": {
          "type": "boolean"
        },
        "authMethod": {
          "enum": [
            "none",
            "claude.ai",
            "oauth_token",
            "api_key",
            "api_key_helper",
            "third_party"
          ]
        },
        "subscriptionType": {
          "enum": [
            "pro",
            "max",
            "team",
            "enterprise",
            "free",
            null
          ]
        },
        "classification": {
          "enum": [
            "compatible-declared",
            "signed-out",
            "incompatible",
            "unresolved"
          ]
        }
      }
    },
    "stats": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "bytes",
        "nodes",
        "keys",
        "peakDepth",
        "peakKeyDigests",
        "retainedRawBytes",
        "retainedUnselectedValueTextBytes",
        "retainedApprovedScalarCount"
      ],
      "properties": {
        "bytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "nodes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "keys": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "peakDepth": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "peakKeyDigests": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "retainedRawBytes": {
          "const": 0
        },
        "retainedUnselectedValueTextBytes": {
          "const": 0
        },
        "retainedApprovedScalarCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3
        }
      }
    },
    "parserReport": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scope",
        "state",
        "projection",
        "stats",
        "reason",
        "nativeExecuted",
        "inferenceRequested",
        "runtimeReady",
        "verifiedAdmission",
        "externalBillingVerified"
      ],
      "properties": {
        "scope": {
          "const": "auth-diagnostic-provided-bytes"
        },
        "state": {
          "enum": [
            "incomplete",
            "invalid",
            "observed"
          ]
        },
        "projection": {
          "anyOf": [
            {
              "$ref": "#/$defs/projection"
            },
            {
              "type": "null"
            }
          ]
        },
        "stats": {
          "$ref": "#/$defs/stats"
        },
        "reason": {
          "enum": [
            "auth-observed",
            "auth-incomplete",
          "auth-node-limit",
          "auth-root-object-required",
            "auth-invalid-json",
            "auth-invalid-type",
            "auth-depth-limit",
            "auth-key-bytes-limit",
            "auth-invalid-enum",
            "auth-invalid-unicode",
            "auth-duplicate-key",
            "auth-key-limit",
            "auth-invalid-utf8",
            "auth-block-invalid",
            "auth-byte-limit",
            "auth-closed",
            "auth-truncated",
            "auth-required-field",
            "auth-exit-mismatch",
            "auth-aborted"
          ]
        },
        "nativeExecuted": {
          "const": false
        },
        "inferenceRequested": {
          "const": false
        },
        "runtimeReady": {
          "const": false
        },
        "verifiedAdmission": {
          "const": false
        },
        "externalBillingVerified": {
          "const": false
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "state": {
                "const": "observed"
              }
            }
          },
          "then": {
            "properties": {
              "projection": {
                "$ref": "#/$defs/projection"
              }
            }
          },
          "else": {
            "properties": {
              "projection": {
                "type": "null"
              }
            }
          }
        }
      ]
    },
    "pin": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "dev",
        "ino",
        "uid",
        "mode",
        "size",
        "mtimeMs",
        "ctimeMs",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "dev": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "ino": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "uid": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "mode": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4095
        },
        "size": {
          "type": "integer",
          "minimum": 1,
          "maximum": 536870912
        },
        "mtimeMs": {
          "type": "number",
          "minimum": 0
        },
        "ctimeMs": {
          "type": "number",
          "minimum": 0
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "link": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "dev",
        "ino",
        "uid",
        "mode",
        "size",
        "mtimeMs",
        "ctimeMs"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "dev": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "ino": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "uid": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "mode": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4095
        },
        "size": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "mtimeMs": {
          "type": "number",
          "minimum": 0
        },
        "ctimeMs": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "parent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "dev",
        "ino",
        "uid",
        "mode"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "dev": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "ino": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "uid": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "mode": {
          "const": 448
        }
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "bindingSha256",
        "evidenceSha256"
      ],
      "properties": {
        "state": {
          "enum": [
            "pending",
            "rejected",
            "reviewed"
          ]
        },
        "bindingSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "evidenceSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "startupReview": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "bindingSha256",
        "evidenceSha256",
        "effectsEnumerated",
        "unresolvedEffects"
      ],
      "properties": {
        "state": {
          "enum": [
            "pending",
            "rejected",
            "reviewed"
          ]
        },
        "bindingSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "evidenceSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "effectsEnumerated": {
          "type": "boolean"
        },
        "unresolvedEffects": {
          "type": "boolean"
        }
      }
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "processTimeoutMs",
        "totalTimeoutMs",
        "graceMs",
        "confirmationMs",
        "maxOutputBytes",
        "maxErrorBytes",
        "permitLifetimeMs"
      ],
      "properties": {
        "processTimeoutMs": {
          "type": "integer",
          "minimum": 25,
          "maximum": 15000
        },
        "totalTimeoutMs": {
          "type": "integer",
          "minimum": 25,
          "maximum": 90000
        },
        "graceMs": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000
        },
        "confirmationMs": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000
        },
        "maxOutputBytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 32768
        },
        "maxErrorBytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 32768
        },
        "permitLifetimeMs": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3600000
        }
      }
    },
    "configuration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "recipe",
        "version",
        "artifact",
        "entryLink",
        "workspaceParent",
        "excludedRoots",
        "identityReview",
        "startupReview",
        "limits"
      ],
      "properties": {
        "source": {
          "enum": [
            "synthetic-fixture",
            "native-client-declaration"
          ]
        },
        "recipe": {
          "const": "auth-status-v1"
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9.+_-]*$"
        },
        "artifact": {
          "$ref": "#/$defs/pin"
        },
        "entryLink": {
          "$ref": "#/$defs/link"
        },
        "workspaceParent": {
          "$ref": "#/$defs/parent"
        },
        "excludedRoots": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          }
        },
        "identityReview": {
          "$ref": "#/$defs/review"
        },
        "startupReview": {
          "$ref": "#/$defs/startupReview"
        },
        "limits": {
          "$ref": "#/$defs/limits"
        }
      }
    },
    "report": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scope",
        "source",
        "state",
        "spawnAttempts",
        "processStarted",
        "nativeExecuted",
        "artifactMatchedBefore",
        "artifactMatchedAfter",
        "terminationConfirmed",
        "cleanupRequired",
        "stdoutBytes",
        "stderrBytes",
        "elapsedMs",
        "projection",
        "reasons",
        "inferenceRequested",
        "runtimeReady",
        "verifiedAdmission",
        "externalBillingVerified",
        "remoteCancellationVerified",
        "actualModelCalls"
      ],
      "properties": {
        "scope": {
          "const": "auth-status-only"
        },
        "source": {
          "enum": [
            "synthetic-fixture",
            "native-client-declaration"
          ]
        },
        "state": {
          "enum": [
            "blocked-before-start",
            "failed",
            "canceled",
            "timed-out",
            "indeterminate",
            "observation-complete"
          ]
        },
        "spawnAttempts": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1
        },
        "processStarted": {
          "type": "boolean"
        },
        "nativeExecuted": {
          "type": "boolean"
        },
        "artifactMatchedBefore": {
          "type": "boolean"
        },
        "artifactMatchedAfter": {
          "type": "boolean"
        },
        "terminationConfirmed": {
          "type": "boolean"
        },
        "cleanupRequired": {
          "type": "boolean"
        },
        "stdoutBytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "stderrBytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "elapsedMs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "projection": {
          "anyOf": [
            {
              "$ref": "#/$defs/projection"
            },
            {
              "type": "null"
            }
          ]
        },
        "reasons": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "enum": [
              "auth-permission-rejected",
              "auth-input-forbidden",
              "auth-startup-not-reviewed",
              "auth-canceled",
              "auth-local-check-failed",
              "auth-spawn-failed",
              "auth-signal-unconfirmed",
              "auth-group-unconfirmed",
              "auth-termination-unconfirmed",
              "auth-protocol-invalid",
              "auth-permission-revoked",
              "auth-deadline",
              "auth-descendants-unconfirmed",
              "auth-pid-unavailable",
              "auth-process-error",
              "auth-stream-error",
              "auth-output-limit",
              "auth-output-invalid",
              "auth-stderr-limit",
              "auth-stderr-not-empty",
              "auth-stderr-invalid",
              "auth-workspace-cleanup-required",
              "auth-workspace-retained",
              "auth-observation-complete",
              "auth-failed"
            ]
          }
        },
        "inferenceRequested": {
          "const": false
        },
        "runtimeReady": {
          "const": false
        },
        "verifiedAdmission": {
          "const": false
        },
        "externalBillingVerified": {
          "const": false
        },
        "remoteCancellationVerified": {
          "const": false
        },
        "actualModelCalls": {
          "type": "null"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "state": {
                "const": "observation-complete"
              }
            }
          },
          "then": {
            "properties": {
              "projection": {
                "$ref": "#/$defs/projection"
              },
              "processStarted": {
                "const": true
              },
              "artifactMatchedBefore": {
                "const": true
              },
              "artifactMatchedAfter": {
                "const": true
              },
              "terminationConfirmed": {
                "const": true
              },
              "cleanupRequired": {
                "const": false
              },
              "spawnAttempts": {
                "const": 1
              }
            }
          },
          "else": {
            "properties": {
              "projection": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "source": {
                "const": "synthetic-fixture"
              }
            }
          },
          "then": {
            "properties": {
              "nativeExecuted": {
                "const": false
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "nativeExecuted": {
                "const": true
              }
            }
          },
          "then": {
            "properties": {
              "source": {
                "const": "native-client-declaration"
              },
              "processStarted": {
                "const": true
              },
              "spawnAttempts": {
                "const": 1
              }
            }
          }
        }
      ]
    }
  }
}
