{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-toolkit.local/schemas/agent-client-native-preflight.schema.json",
  "$defs": {
    "sha": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "ref": {"type": ["string", "null"], "pattern": "^[a-z][a-z0-9-]{0,63}$"},
    "time": {"type": ["string", "null"], "format": "date-time"},
    "assessment": {
      "type": "object", "additionalProperties": false,
      "required": ["source", "referenceId", "checkedAt", "scopeSha256"],
      "properties": {
        "source": {"enum": ["documented", "operator-attested", "locally-observed", "pending"]},
        "referenceId": {"$ref": "#/$defs/ref"}, "checkedAt": {"$ref": "#/$defs/time"},
        "scopeSha256": {"anyOf": [{"$ref": "#/$defs/sha"}, {"type": "null"}]}
      }
    },
    "field": {
      "type": "object", "additionalProperties": false,
      "required": ["name", "state", "assessment"],
      "properties": {
        "name": {"enum": ["policy", "hooks", "commands", "mcp", "connectors", "api-helper", "third-party", "fallback", "delegation"]},
        "state": {"enum": ["absent", "disabled", "present", "unknown"]}, "assessment": {"$ref": "#/$defs/assessment"}
      }
    },
    "projection": {
      "type": "object", "additionalProperties": false, "required": ["safeSource", "fields"],
      "properties": {"safeSource": {"type": "boolean"}, "fields": {"type": "array", "maxItems": 9, "items": {"$ref": "#/$defs/field"}}}
    },
    "auth": {
      "type": "object", "additionalProperties": false,
      "required": ["loggedIn", "authMethod", "subscriptionType"],
      "properties": {
        "loggedIn": {"type": "boolean"},
        "authMethod": {"enum": ["none", "claude.ai", "oauth_token", "api_key", "api_key_helper", "third_party"]},
        "subscriptionType": {"enum": ["pro", "max", "team", "enterprise", "free", null]}
      }
    },
    "access": {
      "type": "object", "additionalProperties": false, "required": ["data", "assessment"],
      "properties": {"data": {"$ref": "#/$defs/auth"}, "assessment": {"$ref": "#/$defs/assessment"}}
    },
    "economy": {
      "type": "object", "additionalProperties": false,
      "required": ["state", "source", "referenceId", "receivedAt", "scopeSha256", "sessionContinuity"],
      "properties": {
        "state": {"enum": ["disabled", "enabled", "unknown"]}, "source": {"enum": ["operator-attested", "pending"]},
        "referenceId": {"$ref": "#/$defs/ref"}, "receivedAt": {"$ref": "#/$defs/time"},
        "scopeSha256": {"anyOf": [{"$ref": "#/$defs/sha"}, {"type": "null"}]}, "sessionContinuity": {"type": ["boolean", "null"]}
      }
    },
    "input": {
      "type": "object", "additionalProperties": false,
      "required": ["schemaVersion", "scope", "now", "candidateScopeSha256", "projection"],
      "properties": {
        "schemaVersion": {"const": "1.0.0"}, "scope": {"const": "native-preflight-only"},
        "now": {"type": "string", "format": "date-time"}, "candidateScopeSha256": {"$ref": "#/$defs/sha"},
        "projection": {"$ref": "#/$defs/projection"}, "access": {"$ref": "#/$defs/access"}, "economy": {"$ref": "#/$defs/economy"}
      }
    },
    "accessReport": {
      "type": "object", "additionalProperties": false,
      "required": ["scope", "state", "nativeExecuted", "spawnAttempts", "inferenceRequested", "actualModelCalls", "runtimeReady", "verifiedAdmission", "externalBillingVerified", "remoteCancellationVerified", "terminationConfirmed", "stdoutBytes", "stderrBytes", "elapsedMs", "preflight", "reasons"],
      "properties": {
        "scope": {"const": "native-access-only"}, "state": {"enum": ["blocked", "completed", "failed", "canceled", "timed-out", "indeterminate"]},
        "nativeExecuted": {"type": "boolean"}, "spawnAttempts": {"type": "integer", "minimum": 0, "maximum": 1},
        "inferenceRequested": {"const": false}, "actualModelCalls": {"type": "null"}, "runtimeReady": {"const": false},
        "verifiedAdmission": {"const": false}, "externalBillingVerified": {"const": false}, "remoteCancellationVerified": {"const": false},
        "terminationConfirmed": {"type": "boolean"},
        "stdoutBytes": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
        "stderrBytes": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
        "elapsedMs": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
        "preflight": {"anyOf": [{"$ref": "#/$defs/report"}, {"type": "null"}]},
        "reasons": {"type": "array", "uniqueItems": true, "maxItems": 24, "items": {"enum": ["access-controls-insufficient", "access-local-check-failed", "access-signal-unconfirmed", "access-group-unconfirmed", "access-termination-unconfirmed", "access-response-invalid", "access-deadline", "access-descendants-unconfirmed", "access-spawn-failed", "access-process-error", "access-output-limit", "access-stderr-limit", "access-utf8-invalid", "access-canceled", "access-completed", "access-preflight-incompatible", "access-workspace-cleanup-required"]}}
      }
    },
    "report": {
      "type": "object", "additionalProperties": false,
      "required": ["scope", "state", "queryEligible", "nativeExecuted", "inferenceRequested", "actualModelCalls", "runtimeReady", "verifiedAdmission", "externalBillingVerified", "remoteCancellationVerified", "reasons", "unresolvedFields", "audit"],
      "properties": {
        "scope": {"const": "native-preflight-only"}, "state": {"enum": ["invalid", "incomplete", "blocked", "review-complete"]},
        "queryEligible": {"type": "boolean"}, "nativeExecuted": {"const": false}, "inferenceRequested": {"const": false},
        "actualModelCalls": {"type": "null"}, "runtimeReady": {"const": false}, "verifiedAdmission": {"const": false},
        "externalBillingVerified": {"const": false}, "remoteCancellationVerified": {"const": false},
        "reasons": {"type": "array", "uniqueItems": true, "maxItems": 32, "items": {"enum": ["preflight-invalid-input", "preflight-binding-mismatch", "preflight-duplicate-field", "safe-projection-unavailable", "preflight-critical-control-present", "preflight-controls-unresolved", "preflight-evidence-rejected", "preflight-access-unresolved", "preflight-access-incompatible", "preflight-subscription-unresolved", "preflight-economy-unresolved", "preflight-economy-enabled", "preflight-session-unresolved", "preflight-review-complete"]}},
        "unresolvedFields": {"type": "array", "uniqueItems": true, "maxItems": 9, "items": {"$ref": "#/$defs/field/properties/name"}},
        "audit": {"type": "object", "additionalProperties": false, "required": ["inputSha256"], "properties": {"inputSha256": {"anyOf": [{"$ref": "#/$defs/sha"}, {"type": "null"}]}}}
      }
    }
  }
}
