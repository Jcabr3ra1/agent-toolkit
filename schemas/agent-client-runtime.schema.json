          "const": false
        },
        "runtimeReady": {
          "const": false
        },
        "verifiedAdmission": {
          "const": false
        },
        "persisted": {
          "const": false
        },
        "operation": {
          "anyOf": [
            {
              "enum": [
                "reserve",
                "mark-started",
                "interrupt",
                "settle"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "nextLedger": {
          "anyOf": [
            {
              "$ref": "#/$defs/ledger"
            },
            {
              "type": "null"
            }
          ]
        },
        "compareAndSwap": {
          "anyOf": [
