{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-toolkit.local/schemas/agent-client-runtime.schema.json",
  "title": "Client Runtime C1 Offline",
  "description": "Declaraciones y propuestas puras; no ejecuta, persiste o autentica clientes.",
  "$ref": "#/$defs/admissionInput",
  "$defs": {
    "temporal": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "checkedAt",
        "expiresAt",
        "evidenceRef"
      ],
      "properties": {
        "checkedAt": {
          "type": "string",
          "format": "date-time"
        },
        "expiresAt": {
          "type": "string",
          "format": "date-time"
        },
        "evidenceRef": {
          "$ref": "https://agent-toolkit.local/schemas/agent-client-adapter.schema.json#/$defs/id"
        }
      }
    },
    "assessment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "checkedAt",
        "expiresAt",
        "evidenceRef",
        "status",
        "source"
      ],
      "properties": {
        "checkedAt": {
          "type": "string",
          "format": "date-time"
        },
        "expiresAt": {
          "type": "string",
          "format": "date-time"
        },
        "evidenceRef": {
          "$ref": "https://agent-toolkit.local/schemas/agent-client-adapter.schema.json#/$defs/id"
        },
        "status": {
          "enum": [
            "documented",
            "locally-tested",
            "pending",
            "rejected"
          ]
        },
        "source": {
          "enum": [
            "operator-attestation",
            "installation-test",
            "provider-documentation"
          ]
        }
      }
    },
    "installation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "installationId",
        "client",
        "platform",
        "artifactSha256",
        "controlRevision"
      ],
      "properties": {
        "installationId": {
          "$ref": "https://agent-toolkit.local/schemas/agent-client-adapter.schema.json#/$defs/id"
        },
        "client": {
          "$ref": "https://agent-toolkit.local/schemas/agent-client-adapter.schema.json#/$defs/client"
        },
        "platform": {
          "enum": [
            "darwin",
            "linux",
            "win32"
          ]
        },
        "artifactSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "controlRevision": {
          "$ref": "https://agent-toolkit.local/schemas/agent-client-adapter.schema.json#/$defs/id"
        }
      }
    },
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "installationId",
        "client",
        "platform",
        "artifactSha256",
        "controlRevision",
        "identity",
        "planSha256"
      ],
      "properties": {
        "installationId": {
          "$ref": "https://agent-toolkit.local/schemas/agent-client-adapter.schema.json#/$defs/id"
        },
        "client": {
          "$ref": "https://agent-toolkit.local/schemas/agent-client-adapter.schema.json#/$defs/client"
        },
        "platform": {
          "enum": [
            "darwin",
            "linux",
            "win32"
          ]
        },
        "artifactSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "controlRevision": {
          "$ref": "https://agent-toolkit.local/schemas/agent-client-adapter.schema.json#/$defs/id"
        },
        "identity": {
          "$ref": "https://agent-toolkit.local/schemas/agent-client-adapter.schema.json#/$defs/report/properties/identity",
          "type": "object"
        },
        "planSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "binding",
        "installation",
        "authorization",
        "access",
        "context",
        "controls",
        "effects",
        "accounting"
      ],
      "properties": {
        "binding": {
          "$ref": "#/$defs/binding"
        },
        "installation": {
          "$ref": "#/$defs/assessment"
        },
        "authorization": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "checkedAt",
            "expiresAt",
            "evidenceRef",
            "status",
            "referenceId",
            "revoked",
            "effectsApproved",
            "limits"
          ],
          "properties": {
            "checkedAt": {
              "type": "string",
              "format": "date-time"
            },
            "expiresAt": {
              "type": "string",
              "format": "date-time"
            },
            "evidenceRef": {
              "$ref": "https://agent-toolkit.local/schemas/agent-client-adapter.schema.json#/$defs/id"
            },
            "status": {
              "enum": [
                "approved",
                "pending",
                "denied"
              ]
            },
            "referenceId": {
              "$ref": "https://agent-toolkit.local/schemas/agent-client-adapter.schema.json#/$defs/id"
            },
            "revoked": {
              "type": "boolean"
            },
            "effectsApproved": {
              "type": "array",
              "maxItems": 5,
              "items": {
                "enum": [
                  "native-auth",
                  "provider-inference",
                  "client-state",
                  "telemetry",
                  "descendants"
                ]
              },
              "uniqueItems": true
            },
            "limits": {
              "$ref": "#/$defs/limits"
            }
          }
        },
        "access": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "assessment",
            "access",
            "externalBilling"
          ],
          "properties": {
            "assessment": {
              "$ref": "#/$defs/assessment"
            },
            "access": {
              "enum": [
                "subscription-session",
                "unknown",
                "api-key"
              ]
            },
            "externalBilling": {
              "enum": [
                "disabled",
                "enabled",
                "unknown"
              ]
            }
          }
        },
        "context": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "assessment",
            "promptRef",
            "promptSha256",
            "promptBytes"
          ],
          "properties": {
            "assessment": {
              "$ref": "#/$defs/assessment"
            },
            "promptRef": {
              "$ref": "https://agent-toolkit.local/schemas/agent-client-adapter.schema.json#/$defs/id"
            },
            "promptSha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "promptBytes": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1048576
            }
          }
        },
        "controls": {
          "type": "array",
          "maxItems": 11,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "controlId",
              "assessment"
            ],
            "properties": {
              "controlId": {
                "enum": [
                  "no-tools",
                  "no-subagents",
                  "no-mcp",
                  "no-hooks",
                  "no-personalizations",
                  "no-updates",
                  "stdin-text",
                  "no-fallback",
                  "no-resume",
                  "no-permission-bypass",
                  "internal-call-limit"
                ]
              },
              "assessment": {
                "$ref": "#/$defs/assessment"
              }
            }
          }
        },
        "effects": {
          "type": "array",
          "maxItems": 5,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "effectId",
              "disposition",
              "assessment"
            ],
            "properties": {
              "effectId": {
                "enum": [
                  "native-auth",
                  "provider-inference",
                  "client-state",
                  "telemetry",
                  "descendants"
                ]
              },
              "disposition": {
                "enum": [
                  "allowed",
                  "rejected",
                  "unknown"
                ]
              },
              "assessment": {
                "$ref": "#/$defs/assessment"
              }
            }
          }
        },
        "accounting": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "assessment",
            "maxCallsPerStart",
            "limitEnforced"
          ],
          "properties": {
            "assessment": {
              "$ref": "#/$defs/assessment"
            },
            "maxCallsPerStart": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 1000
                },
                {
                  "type": "null"
                }
              ]
            },
            "limitEnforced": {
              "type": "boolean"
            }
          }
        }
      }
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "maxMainStarts",
        "maxModelCalls",
        "maxDurationSeconds"
      ],
      "properties": {
        "maxMainStarts": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000
        },
        "maxModelCalls": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000
        },
        "maxDurationSeconds": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000
        }
      }
    },
    "attempt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "attemptId",
        "identity",
        "planSha256",
        "client",
        "profileId",
        "model",
        "effort",
        "state",
        "startObservation",
        "reservedCalls",
        "reservedSeconds",
        "reservedAt",
        "updatedAt",
        "actualCalls",
        "actualSeconds",
        "outcome",
        "evidenceRef"
      ],
      "properties": {
        "attemptId": {
          "$ref": "https://agent-toolkit.local/schemas/agent-client-adapter.schema.json#/$defs/id"
        },
        "identity": {
          "$ref": "https://agent-toolkit.local/schemas/agent-client-adapter.schema.json#/$defs/report/properties/identity",
          "type": "object"
        },
        "planSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "client": {
          "$ref": "https://agent-toolkit.local/schemas/agent-client-adapter.schema.json#/$defs/client"
        },
        "profileId": {
          "$ref": "https://agent-toolkit.local/schemas/agent-client-adapter.schema.json#/$defs/id"
        },
        "model": {
          "$ref": "https://agent-toolkit.local/schemas/agent-client-adapter.schema.json#/$defs/id"
        },
        "effort": {
          "$ref": "https://agent-toolkit.local/schemas/agent-client-adapter.schema.json#/$defs/id"
        },
        "state": {
          "enum": [
            "reserved",
            "started",
            "settled",
            "reconciliation-required"
          ]
        },
        "startObservation": {
          "enum": [
            "not-reported",
            "started",
            "not-started",
            "unknown"
          ]
        },
        "reservedCalls": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000
        },
        "reservedSeconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 86400
        },
        "reservedAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        },
        "actualCalls": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 1000000
            },
            {
              "type": "null"
            }
          ]
        },
        "actualSeconds": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 1000000
            },
            {
              "type": "null"
            }
          ]
        },
        "outcome": {
          "anyOf": [
            {
              "enum": [
                "not-started",
                "completed",
                "failed",
                "canceled",
                "timed-out",
                "indeterminate"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "evidenceRef": {
          "anyOf": [
            {
              "$ref": "https://agent-toolkit.local/schemas/agent-client-adapter.schema.json#/$defs/id"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "runtimeHistory": {
      "type": "object",
      "additionalProperties": false,
      "required": ["correctionRound", "executionsUsed", "durationUsedSeconds"],
      "properties": {
        "correctionRound": {
          "$ref": "https://agent-toolkit.local/schemas/agent-model-preference.schema.json#/$defs/history/properties/correctionRound"
        },
        "executionsUsed": { "type": "integer", "minimum": 0, "maximum": 1000000 },
        "durationUsedSeconds": { "type": "integer", "minimum": 0, "maximum": 1000000 },
        "previousProfileId": {
          "$ref": "https://agent-toolkit.local/schemas/agent-model-preference.schema.json#/$defs/history/properties/previousProfileId"
        },
        "previousEffort": {
          "$ref": "https://agent-toolkit.local/schemas/agent-model-preference.schema.json#/$defs/history/properties/previousEffort"
        }
      },
      "description": "Contabilidad declarada, ampliada para registrar excesos sin recortarlos. No amplía los límites de selección o autorización."
    },
    "ledger": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "projectId",
        "taskId",
        "revision",
        "status",
        "importEvidenceRef",
        "importedHistory",
        "importedMainStartsUsed",
        "history",
        "mainStartsUsed",
        "limits",
        "attempts"
      ],
      "properties": {
        "schemaVersion": {
          "const": "1.0.0"
        },
        "projectId": {
          "$ref": "https://agent-toolkit.local/schemas/agent-client-adapter.schema.json#/$defs/id"
        },
        "taskId": {
          "$ref": "https://agent-toolkit.local/schemas/agent-client-adapter.schema.json#/$defs/id"
        },
        "revision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000
        },
        "status": {
          "enum": [
            "reconciled",
            "reconciliation-required"
          ]
        },
        "importEvidenceRef": {
          "$ref": "https://agent-toolkit.local/schemas/agent-client-adapter.schema.json#/$defs/id"
        },
        "importedHistory": {
          "$ref": "#/$defs/runtimeHistory"
        },
        "importedMainStartsUsed": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000
        },
        "history": {
          "$ref": "#/$defs/runtimeHistory"
        },
        "mainStartsUsed": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000
        },
        "limits": {
          "$ref": "#/$defs/limits"
        },
        "attempts": {
          "type": "array",
          "maxItems": 128,
          "items": {
            "$ref": "#/$defs/attempt"
          }
        }
      }
    },
    "admissionInput": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "now",
        "planningInput",
        "plan"
      ],
      "properties": {
        "schemaVersion": {
          "const": "1.0.0"
        },
        "now": {
          "type": "string",
          "format": "date-time"
        },
        "planningInput": {
          "$ref": "https://agent-toolkit.local/schemas/agent-client-adapter.schema.json#/$defs/input"
        },
        "plan": {
          "$ref": "https://agent-toolkit.local/schemas/agent-client-adapter.schema.json#/$defs/report"
        },
        "expectedInstallation": {
          "$ref": "#/$defs/installation"
        },
        "evidence": {
          "$ref": "#/$defs/evidence"
        },
        "ledger": {
          "$ref": "#/$defs/ledger"
        }
      }
    },
    "reservation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "identity",
        "planSha256",
        "client",
        "profileId",
        "model",
        "effort",
        "calls",
        "seconds"
      ],
      "properties": {
        "identity": {
          "$ref": "https://agent-toolkit.local/schemas/agent-client-adapter.schema.json#/$defs/report/properties/identity",
          "type": "object"
        },
        "planSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "client": {
          "$ref": "https://agent-toolkit.local/schemas/agent-client-adapter.schema.json#/$defs/client"
        },
        "profileId": {
          "$ref": "https://agent-toolkit.local/schemas/agent-client-adapter.schema.json#/$defs/id"
        },
        "model": {
          "$ref": "https://agent-toolkit.local/schemas/agent-client-adapter.schema.json#/$defs/id"
        },
        "effort": {
          "$ref": "https://agent-toolkit.local/schemas/agent-client-adapter.schema.json#/$defs/id"
        },
        "calls": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000
        },
        "seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 86400
        }
      }
    },
    "admissionReport": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "engineVersion",
        "state",
        "executed",
        "runtimeReady",
        "verifiedAdmission",
        "identity",
        "reservation",
        "missing",
        "reasons",
        "externalGates",
        "audit"
      ],
      "properties": {
        "schemaVersion": {
          "const": "1.0.0"
        },
        "engineVersion": {
          "const": "1.0.0"
        },
        "state": {
          "enum": [
            "invalid",
            "needs-info",
            "blocked",
            "eligible-for-reservation"
          ]
        },
        "executed": {
          "const": false
        },
        "runtimeReady": {
          "const": false
        },
        "verifiedAdmission": {
          "const": false
        },
        "identity": {
          "anyOf": [
            {
              "$ref": "https://agent-toolkit.local/schemas/agent-client-adapter.schema.json#/$defs/report/properties/identity",
              "type": "object"
            },
            {
              "type": "null"
            }
          ]
        },
        "reservation": {
          "anyOf": [
            {
              "$ref": "#/$defs/reservation"
            },
            {
              "type": "null"
            }
          ]
        },
        "missing": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "$ref": "https://agent-toolkit.local/schemas/agent-client-adapter.schema.json#/$defs/id"
          }
        },
        "reasons": {
          "type": "array",
          "maxItems": 128,
          "items": {
            "$ref": "https://agent-toolkit.local/schemas/agent-client-adapter.schema.json#/$defs/id"
          }
        },
        "externalGates": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "$ref": "https://agent-toolkit.local/schemas/agent-client-adapter.schema.json#/$defs/id"
          }
        },
        "audit": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "inputSha256",
            "planSha256",
            "ledgerSha256"
          ],
          "properties": {
            "inputSha256": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                },
                {
                  "type": "null"
                }
              ]
            },
            "planSha256": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                },
                {
                  "type": "null"
                }
              ]
            },
            "ledgerSha256": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                },
                {
                  "type": "null"
                }
              ]
            }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "state": {
                "const": "eligible-for-reservation"
              }
            },
            "required": [
              "state"
            ]
          },
          "then": {
            "properties": {
              "reservation": {
                "type": "object"
              },
              "identity": {
                "type": "object"
              }
            }
          },
          "else": {
            "properties": {
              "reservation": {
                "type": "null"
              }
            }
          }
        }
      ]
    },
    "reconciliation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "checkedAt",
        "expiresAt",
        "evidenceRef",
        "status",
        "referenceId",
        "source",
        "projectId",
        "taskId",
        "attemptId",
        "ledgerSha256",
        "revoked"
      ],
      "properties": {
        "checkedAt": {
          "type": "string",
          "format": "date-time"
        },
        "expiresAt": {
          "type": "string",
          "format": "date-time"
        },
        "evidenceRef": {
          "$ref": "https://agent-toolkit.local/schemas/agent-client-adapter.schema.json#/$defs/id"
        },
        "status": {
          "enum": [
            "approved",
            "pending",
            "denied"
          ]
        },
        "referenceId": {
          "$ref": "https://agent-toolkit.local/schemas/agent-client-adapter.schema.json#/$defs/id"
        },
        "source": {
          "const": "operator-attestation"
        },
        "projectId": {
          "$ref": "https://agent-toolkit.local/schemas/agent-client-adapter.schema.json#/$defs/id"
        },
        "taskId": {
          "$ref": "https://agent-toolkit.local/schemas/agent-client-adapter.schema.json#/$defs/id"
        },
        "attemptId": {
          "$ref": "https://agent-toolkit.local/schemas/agent-client-adapter.schema.json#/$defs/id"
        },
        "ledgerSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "revoked": {
          "type": "boolean"
        }
      }
    },
    "cas": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "expectedRevision",
        "nextRevision",
        "expectedSha256",
        "nextSha256"
      ],
      "properties": {
        "expectedRevision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000
        },
        "nextRevision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000
        },
        "expectedSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "nextSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "stateReport": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "engineVersion",
        "state",
        "executed",
        "runtimeReady",
        "verifiedAdmission",
        "persisted",
        "operation",
        "nextLedger",
        "compareAndSwap",
        "reasons"
      ],
      "properties": {
        "schemaVersion": {
          "const": "1.0.0"
        },
        "engineVersion": {
          "const": "1.0.0"
        },
        "state": {
          "enum": [
            "invalid",
            "blocked",
            "proposed"
          ]
        },
