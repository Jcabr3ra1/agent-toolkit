              "$ref": "#/$defs/cas"
            },
            {
              "type": "null"
            }
          ]
        },
        "reasons": {
          "type": "array",
          "maxItems": 128,
          "items": {
            "$ref": "https://agent-toolkit.local/schemas/agent-client-adapter.schema.json#/$defs/id"
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "state": {
                "const": "proposed"
              }
            },
            "required": [
              "state"
            ]
          },
          "then": {
            "properties": {
              "nextLedger": {
                "type": "object"
              },
              "compareAndSwap": {
                "type": "object"
              }
            }
          },
          "else": {
            "properties": {
              "nextLedger": {
                "type": "null"
              },
              "compareAndSwap": {
                "type": "null"
              }
            }
          }
        }
      ]
    },
