{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-toolkit.local/schemas/agent-task-prepare.schema.json",
  "$defs": {
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "projectId",
        "taskId",
        "revision",
        "role",
        "mode"
      ],
      "properties": {
        "projectId": {
          "$ref": "https://agent-toolkit.local/schemas/agent-model-selection.schema.json#/$defs/id"
        },
        "taskId": {
          "$ref": "https://agent-toolkit.local/schemas/agent-model-selection.schema.json#/$defs/id"
        },
        "revision": {
          "$ref": "https://agent-toolkit.local/schemas/agent-model-selection.schema.json#/$defs/revision"
        },
        "role": {
          "$ref": "https://agent-toolkit.local/schemas/agent-model-selection.schema.json#/$defs/role"
        },
        "mode": {
          "$ref": "https://agent-toolkit.local/schemas/agent-model-selection.schema.json#/$defs/mode"
        },
        "purpose": {
          "enum": [
            "external-verifier"
          ]
        }
      }
    },
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "operation",
        "expectedBase"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "operation": {
          "enum": [
            "inspect",
            "modify",
            "create"
          ]
        },
        "expectedBase": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            {
              "const": "absent"
            }
          ]
        }
      }
    },
    "context": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "locator",
        "sha256"
      ],
      "properties": {
        "id": {
          "$ref": "https://agent-toolkit.local/schemas/agent-model-selection.schema.json#/$defs/id"
        },
        "kind": {
          "enum": [
            "source",
            "memory",
            "decision",
            "instructions",
            "evidence"
          ]
        },
        "locator": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "sha256": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "delivery": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "revision",
        "locator",
        "sha256"
      ],
      "properties": {
        "revision": {
          "$ref": "https://agent-toolkit.local/schemas/agent-model-selection.schema.json#/$defs/revision"
        },
        "locator": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "task": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "schemaVersion",
        "identity",
        "title",
        "objective",
        "step",
        "base",
        "projectRules",
        "scope",
        "contextRefs",
        "previousDeliveries",
        "proposalRef",
        "criteria",
        "checks",
        "deliveryInstructions"
      ],
      "properties": {
        "kind": {
          "const": "agent-task-brief"
        },
        "schemaVersion": {
          "enum": [
            "1.0.0",
            "1.1.0"
          ]
        },
        "identity": {
          "$ref": "#/$defs/identity"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "objective": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "step": {
          "anyOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "number",
                "description"
              ],
              "properties": {
                "number": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 10000
                },
                "description": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 1000
                }
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "base": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "repositoryRoot",
            "branch",
            "head",
            "initialGitState",
            "instructionRefs"
          ],
          "properties": {
            "repositoryRoot": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096
            },
            "branch": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1000
            },
            "head": {
              "type": "string",
              "pattern": "^(?:[a-f0-9]{40}|[a-f0-9]{64})$"
            },
            "initialGitState": {
              "type": "array",
              "minItems": 0,
              "maxItems": 32,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "path",
                  "operation",
                  "owner"
                ],
                "properties": {
                  "path": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 512
                  },
                  "operation": {
                    "enum": [
                      "modified",
                      "added",
                      "deleted",
                      "untracked"
                    ]
                  },
                  "owner": {
                    "enum": [
                      "task",
                      "other",
                      "unknown"
                    ]
                  }
                }
              }
            },
            "instructionRefs": {
              "type": "array",
              "minItems": 1,
              "maxItems": 32,
              "items": {
                "$ref": "#/$defs/context"
              }
            }
          }
        },
        "projectRules": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "allowedModes",
            "activeWriter",
            "forbiddenActions"
          ],
          "properties": {
            "allowedModes": {
              "type": "array",
              "minItems": 1,
              "maxItems": 2,
              "items": {
                "$ref": "https://agent-toolkit.local/schemas/agent-model-selection.schema.json#/$defs/mode"
              },
              "uniqueItems": true
            },
            "activeWriter": {
              "enum": [
                "user",
                "authorized-executor"
              ]
            },
            "forbiddenActions": {
              "type": "array",
              "minItems": 0,
              "maxItems": 5,
              "items": {
                "enum": [
                  "read",
                  "explain",
                  "propose",
                  "apply",
                  "verify"
                ]
              },
              "uniqueItems": true
            }
          }
        },
        "scope": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "included",
            "excluded",
            "files"
          ],
          "properties": {
            "included": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1000
            },
            "excluded": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1000
            },
            "files": {
              "type": "array",
              "minItems": 1,
              "maxItems": 64,
              "items": {
                "$ref": "#/$defs/file"
              }
            }
          }
        },
        "contextRefs": {
          "type": "array",
          "minItems": 0,
          "maxItems": 32,
          "items": {
            "$ref": "#/$defs/context"
          }
        },
        "previousDeliveries": {
          "type": "array",
          "minItems": 0,
          "maxItems": 32,
          "items": {
            "$ref": "#/$defs/delivery"
          }
        },
        "proposalRef": {
          "anyOf": [
            {
              "$ref": "#/$defs/delivery"
            },
            {
              "type": "null"
            }
          ]
        },
        "criteria": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "result",
              "verification"
            ],
            "properties": {
              "id": {
                "$ref": "https://agent-toolkit.local/schemas/agent-model-selection.schema.json#/$defs/id"
              },
              "result": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1000
              },
              "verification": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1000
              }
            }
          }
        },
        "checks": {
          "type": "array",
          "minItems": 0,
          "maxItems": 16,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "command",
              "directory"
            ],
            "properties": {
              "command": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1000
              },
              "directory": {
                "type": "string",
                "minLength": 1,
                "maxLength": 512
              }
            }
          }
        },
        "deliveryInstructions": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        }
      },
      "allOf": [
        {
          "if": {
            "type": "object",
            "properties": {
              "identity": {
                "type": "object",
                "properties": {
                  "purpose": {
                    "const": "external-verifier"
                  }
                },
                "required": [
                  "purpose"
                ]
              }
            },
            "required": [
              "identity"
            ]
          },
          "then": {
            "properties": {
              "schemaVersion": {
                "const": "1.1.0"
              }
            }
          }
        }
      ]
    },
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "task",
        "request",
        "catalog",
        "policy"
      ],
      "properties": {
        "task": {
          "$ref": "#/$defs/task"
        },
        "request": {
          "$ref": "https://agent-toolkit.local/schemas/agent-model-preference.schema.json#/$defs/request"
        },
        "catalog": {
          "$ref": "https://agent-toolkit.local/schemas/agent-model-preference.schema.json#/$defs/catalog"
        },
        "policy": {
          "$ref": "https://agent-toolkit.local/schemas/agent-model-preference.schema.json#/$defs/policy"
        }
      }
    },
    "recommendation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profileId",
        "provider",
        "client",
        "requestedModel",
        "versionPolicy",
        "familyId",
        "familyRank",
        "familyEvidenceRefs",
        "versionOrdinal",
        "versionEvidenceRefs",
        "effort",
        "effortRank",
        "effortRuleId",
        "effortEvidenceRefs",
        "progressionRank",
        "evaluationEvidenceRefs",
        "availabilityEvidence"
      ],
      "properties": {
        "profileId": {
          "$ref": "https://agent-toolkit.local/schemas/agent-model-selection.schema.json#/$defs/id"
        },
        "provider": {
          "$ref": "https://agent-toolkit.local/schemas/agent-model-selection.schema.json#/$defs/id"
        },
        "client": {
          "$ref": "https://agent-toolkit.local/schemas/agent-model-selection.schema.json#/$defs/id"
        },
        "requestedModel": {
          "$ref": "https://agent-toolkit.local/schemas/agent-model-selection.schema.json#/$defs/profile/properties/requestedModel"
        },
        "versionPolicy": {
          "$ref": "https://agent-toolkit.local/schemas/agent-model-selection.schema.json#/$defs/profile/properties/versionPolicy"
        },
        "familyId": {
          "$ref": "https://agent-toolkit.local/schemas/agent-model-selection.schema.json#/$defs/id"
        },
        "familyRank": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "familyEvidenceRefs": {
          "$ref": "https://agent-toolkit.local/schemas/agent-model-selection.schema.json#/$defs/evidenceRefs"
        },
        "versionOrdinal": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "versionEvidenceRefs": {
          "$ref": "https://agent-toolkit.local/schemas/agent-model-selection.schema.json#/$defs/evidenceRefs"
        },
        "effort": {
          "anyOf": [
            {
              "$ref": "https://agent-toolkit.local/schemas/agent-model-selection.schema.json#/$defs/id"
            },
            {
              "type": "null"
            }
          ]
        },
        "effortRank": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "effortRuleId": {
          "$ref": "https://agent-toolkit.local/schemas/agent-model-selection.schema.json#/$defs/id"
        },
        "effortEvidenceRefs": {
          "$ref": "https://agent-toolkit.local/schemas/agent-model-selection.schema.json#/$defs/evidenceRefs"
        },
        "progressionRank": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "evaluationEvidenceRefs": {
          "$ref": "https://agent-toolkit.local/schemas/agent-model-selection.schema.json#/$defs/evidenceRefs"
        },
        "availabilityEvidence": {
          "$ref": "https://agent-toolkit.local/schemas/agent-model-selection.schema.json#/$defs/availability"
        }
      }
    },
    "constraints": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider",
        "client",
        "mode",
        "authorizationContext",
        "history",
        "maxCorrectionRounds",
        "maxFutureExecutions",
        "maxFutureDurationSeconds",
        "accessType",
        "execution"
      ],
      "properties": {
        "provider": {
          "anyOf": [
            {
              "$ref": "https://agent-toolkit.local/schemas/agent-model-selection.schema.json#/$defs/id"
            },
            {
              "type": "null"
            }
          ]
        },
        "client": {
          "anyOf": [
            {
              "$ref": "https://agent-toolkit.local/schemas/agent-model-selection.schema.json#/$defs/id"
            },
            {
              "type": "null"
            }
          ]
        },
        "mode": {
          "$ref": "https://agent-toolkit.local/schemas/agent-model-selection.schema.json#/$defs/mode"
        },
        "authorizationContext": {
          "anyOf": [
            {
              "$ref": "https://agent-toolkit.local/schemas/agent-model-selection.schema.json#/$defs/authorizationContext"
            },
            {
              "type": "null"
            }
          ]
        },
        "history": {
          "anyOf": [
            {
              "$ref": "https://agent-toolkit.local/schemas/agent-model-preference.schema.json#/$defs/history"
            },
            {
              "type": "null"
            }
          ]
        },
        "maxCorrectionRounds": {
          "const": 2
        },
        "maxFutureExecutions": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "maxFutureDurationSeconds": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "accessType": {
          "const": "session-account"
        },
        "execution": {
          "const": "recommend-only"
        }
      }
    },
    "selectorAudit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaSha256",
        "baseSchemaSha256",
        "requestSha256",
        "catalogSha256",
        "policySha256",
        "catalog",
        "policy"
      ],
      "properties": {
        "schemaSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "baseSchemaSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "requestSha256": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "catalogSha256": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "policySha256": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "catalog": {
          "anyOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "revision"
              ],
              "properties": {
                "id": {
                  "$ref": "https://agent-toolkit.local/schemas/agent-model-selection.schema.json#/$defs/id"
                },
                "revision": {
                  "$ref": "https://agent-toolkit.local/schemas/agent-model-selection.schema.json#/$defs/revision"
                }
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "policy": {
          "anyOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "revision"
              ],
              "properties": {
                "id": {
                  "$ref": "https://agent-toolkit.local/schemas/agent-model-selection.schema.json#/$defs/id"
                },
                "revision": {
                  "$ref": "https://agent-toolkit.local/schemas/agent-model-selection.schema.json#/$defs/revision"
                }
              }
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "selection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "selectorVersion",
        "recommendation",
        "constraints",
        "audit",
        "reasons",
        "missing",
        "issues",
        "excluded",
        "effortExcluded"
      ],
      "properties": {
        "state": {
          "enum": [
            "recommended",
            "needs-info",
            "blocked",
            "invalid"
          ]
        },
        "selectorVersion": {
          "const": "2.0.0"
        },
        "recommendation": {
          "anyOf": [
            {
              "$ref": "#/$defs/recommendation"
            },
            {
              "type": "null"
            }
          ]
        },
        "constraints": {
          "anyOf": [
            {
              "$ref": "#/$defs/constraints"
            },
            {
              "type": "null"
            }
          ]
        },
        "audit": {
          "$ref": "#/$defs/selectorAudit"
        },
        "reasons": {
          "type": "array",
          "minItems": 0,
          "maxItems": 512,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9.-]{0,95}$"
          }
        },
        "missing": {
          "type": "array",
          "minItems": 0,
          "maxItems": 64,
          "items": {
            "type": "string",
            "pattern": "^[a-z][A-Za-z0-9.]{0,95}$"
          }
        },
        "issues": {
          "type": "array",
          "minItems": 0,
          "maxItems": 512,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "code",
              "document"
            ],
            "properties": {
              "code": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9.-]{0,95}$"
              },
              "document": {
                "enum": [
                  "request",
                  "catalog",
                  "policy"
                ]
              }
            }
          }
        },
        "excluded": {
          "type": "array",
          "minItems": 0,
          "maxItems": 256,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "profileId",
              "reasons"
            ],
            "properties": {
              "profileId": {
                "$ref": "https://agent-toolkit.local/schemas/agent-model-selection.schema.json#/$defs/id"
              },
              "reasons": {
                "type": "array",
                "minItems": 0,
                "maxItems": 32,
                "items": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9.-]{0,95}$"
                }
              }
            }
          }
        },
        "effortExcluded": {
          "type": "array",
          "minItems": 0,
          "maxItems": 65536,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "profileId",
              "effort",
              "reasons"
            ],
            "properties": {
              "profileId": {
                "$ref": "https://agent-toolkit.local/schemas/agent-model-selection.schema.json#/$defs/id"
              },
              "effort": {
                "anyOf": [
                  {
                    "$ref": "https://agent-toolkit.local/schemas/agent-model-selection.schema.json#/$defs/id"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "reasons": {
                "type": "array",
                "minItems": 0,
                "maxItems": 32,
                "items": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9.-]{0,95}$"
                }
              }
            }
          }
        }
      }
    },
    "audit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "taskSha256",
        "taskSchemaSha256",
        "baseSchemaSha256",
        "preferenceSchemaSha256",
        "sourceByteHashes"
      ],
      "properties": {
        "taskSha256": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "taskSchemaSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "baseSchemaSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "preferenceSchemaSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "sourceByteHashes": {
          "anyOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "task",
                "request",
                "catalog",
                "policy"
              ],
              "properties": {
                "task": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                },
                "request": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                },
                "catalog": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                },
                "policy": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                }
              }
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "report": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "command",
        "schemaVersion",
        "state",
        "selectionState",
        "identity",
        "selection",
        "brief",
        "reasons",
        "missing",
        "audit",
        "executed",
