{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-toolkit.local/schemas/agent-client-output.schema.json",
  "title": "Offline Client Output v1",
  "description": "Parsing de capturas como datos no autenticados; no ejecuta ni certifica clientes.",
  "$ref": "#/$defs/metadata",
  "$defs": {
    "config": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "supportedClients"
      ],
      "properties": {
        "schemaVersion": {
          "const": "1.0.0"
        },
        "supportedClients": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "descriptor",
              "formatId"
            ],
            "properties": {
              "descriptor": {
                "$ref": "https://agent-toolkit.local/schemas/agent-client-adapter.schema.json#/$defs/client"
              },
              "formatId": {
                "enum": [
                  "codex-jsonl-text-v1",
                  "claude-jsonl-text-v1",
                  "antigravity-jsonl-text-v1"
                ]
              }
            }
          }
        }
      }
    },
    "process": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "exitCode",
        "signal",
        "elapsedSeconds"
      ],
      "properties": {
        "exitCode": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 255
            },
            {
              "type": "null"
            }
          ]
        },
        "signal": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^SIG[A-Z0-9]{1,24}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "elapsedSeconds": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0,
              "maximum": 86400
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "plan",
        "captureRef"
      ],
      "properties": {
        "schemaVersion": {
          "const": "1.0.0"
        },
        "plan": {
          "$ref": "https://agent-toolkit.local/schemas/agent-client-adapter.schema.json#/$defs/report"
        },
        "captureRef": {
          "$ref": "https://agent-toolkit.local/schemas/agent-client-adapter.schema.json#/$defs/id"
        },
        "processObservation": {
          "$ref": "#/$defs/process"
        }
      }
    },
    "observation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "value",
        "verification",
        "match",
        "source",
        "scope"
      ],
      "properties": {
        "value": {
          "anyOf": [
            {
              "$ref": "https://agent-toolkit.local/schemas/agent-client-adapter.schema.json#/$defs/id"
            },
            {
              "type": "null"
            }
          ]
        },
        "verification": {
          "enum": [
            "reported",
            "unknown"
          ]
        },
        "match": {
          "enum": [
            "matched",
            "mismatched",
            "unknown"
          ]
        },
        "source": {
          "anyOf": [
            {
              "enum": [
                "client-init",
                "claude-assistant-message"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "scope": {
          "anyOf": [
            {
              "enum": [
                "configuration",
                "response"
              ]
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": { "verification": { "const": "unknown" } },
            "required": ["verification"]
          },
          "then": {
            "properties": {
              "value": { "type": "null" },
              "match": { "const": "unknown" },
              "source": { "type": "null" },
              "scope": { "type": "null" }
            }
          },
          "else": {
            "properties": {
              "value": { "type": "string" },
              "match": { "enum": ["matched", "mismatched"] },
              "source": { "type": "string" },
              "scope": { "type": "string" }
            }
          }
        }
      ]
    },
    "usage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "inputTokens",
        "outputTokens",
        "cacheReadTokens",
        "reasoningTokens",
        "totalTokens"
      ],
      "properties": {
        "inputTokens": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        },
        "outputTokens": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        },
        "cacheReadTokens": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        },
        "reasoningTokens": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        },
        "totalTokens": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "report": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "parserVersion",
        "state",
        "nativeState",
        "executed",
        "verifiedExecution",
        "reviewRequired",
        "client",
        "captureRef",
        "identity",
        "requested",
        "response",
        "model",
        "configuredModel",
        "configuredEffort",
        "effort",
        "usage",
        "usageScope",
        "durationSeconds",
        "processObservation",
        "eventCount",
        "stderrBytes",
        "reasons",
        "audit"
      ],
      "properties": {
        "schemaVersion": {
          "const": "1.0.0"
        },
        "parserVersion": {
          "const": "1.0.0"
        },
        "state": {
          "enum": [
            "invalid",
            "blocked",
            "incomplete",
            "accepted"
          ]
        },
        "nativeState": {
          "enum": [
            "unknown",
            "completed",
            "failed",
            "canceled",
            "interrupted",
            "waiting",
            "running"
          ]
        },
        "executed": {
          "const": false
        },
        "verifiedExecution": {
          "const": false
        },
        "reviewRequired": {
          "const": true
        },
        "client": {
          "anyOf": [
            {
              "$ref": "https://agent-toolkit.local/schemas/agent-client-adapter.schema.json#/$defs/client"
            },
            {
              "type": "null"
            }
          ]
        },
        "captureRef": {
          "anyOf": [
            {
              "$ref": "https://agent-toolkit.local/schemas/agent-client-adapter.schema.json#/$defs/id"
            },
            {
              "type": "null"
            }
          ]
        },
        "identity": {
          "$ref": "https://agent-toolkit.local/schemas/agent-client-adapter.schema.json#/$defs/report/properties/identity"
        },
        "requested": {
          "anyOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "model",
                "effort"
              ],
              "properties": {
                "model": {
                  "$ref": "https://agent-toolkit.local/schemas/agent-client-adapter.schema.json#/$defs/id"
                },
                "effort": {
                  "$ref": "https://agent-toolkit.local/schemas/agent-client-adapter.schema.json#/$defs/id"
                }
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "response": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 1048576
            },
            {
              "type": "null"
            }
          ]
        },
        "model": {
          "$ref": "#/$defs/observation"
        },
        "configuredModel": {
          "$ref": "#/$defs/observation"
        },
        "configuredEffort": {
          "$ref": "#/$defs/observation"
        },
        "effort": {
          "$ref": "#/$defs/observation",
          "const": { "value": null, "verification": "unknown", "match": "unknown", "source": null, "scope": null }
        },
        "usage": {
          "$ref": "#/$defs/usage"
        },
        "usageScope": {
          "anyOf": [
            {
              "enum": [
                "terminal-native-report"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "durationSeconds": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0,
              "maximum": 86400
            },
            {
              "type": "null"
            }
          ]
        },
        "processObservation": {
          "anyOf": [
            {
              "$ref": "#/$defs/process"
            },
            {
              "type": "null"
            }
          ]
        },
        "eventCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000
        },
        "stderrBytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 65536
        },
        "reasons": {
          "type": "array",
          "uniqueItems": true,
          "maxItems": 128,
          "items": {
            "$ref": "https://agent-toolkit.local/schemas/agent-client-adapter.schema.json#/$defs/id"
          }
        },
        "audit": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "planSha256",
            "stdoutSha256",
            "stderrSha256"
          ],
          "properties": {
            "planSha256": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                },
                {
                  "type": "null"
                }
              ]
            },
            "stdoutSha256": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                },
                {
                  "type": "null"
                }
              ]
            },
            "stderrSha256": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                },
                {
                  "type": "null"
                }
              ]
            }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "state": {
                "const": "accepted"
              }
            },
            "required": [
              "state"
            ]
          },
          "then": {
            "properties": {
              "nativeState": {
                "const": "completed"
              },
              "response": {
                "type": "string",
                "minLength": 1
              },
              "client": { "type": "object" },
              "identity": { "type": "object" },
              "captureRef": { "type": "string" },
              "requested": { "type": "object" },
              "processObservation": {
                "type": "object",
                "properties": {
                  "exitCode": { "const": 0 },
                  "signal": { "type": "null" }
                }
              }
            }
          },
          "else": {
            "properties": {
              "response": {
                "type": "null"
              }
            }
          }
        }
      ]
    }
  }
}
