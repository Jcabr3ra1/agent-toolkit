{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-toolkit.local/schemas/agent-client-isolated-verification.schema.json",
  "$ref": "#/$defs/input",
  "$defs": {
    "id": { "$ref": "agent-client-isolated-variant.schema.json#/$defs/id" },
    "digest": { "$ref": "agent-client-isolated-variant.schema.json#/$defs/digest" },
    "time": { "$ref": "agent-client-isolated-variant.schema.json#/$defs/time" },
    "mechanismId": { "$ref": "agent-client-isolated-variant.schema.json#/$defs/mechanismId" },
    "methodId": { "enum": ["documentation-review", "structure-review", "fixture-test", "native-test"] },
    "phase": { "enum": ["pre-start", "session", "shutdown"] },
    "phases": { "type": "array", "maxItems": 3, "items": { "$ref": "#/$defs/phase" } },
    "evidence": {
      "type": "object", "additionalProperties": false,
      "required": ["provenance", "basis", "outcome", "referenceId", "observedAt", "scopeSha256", "definitionSha256"],
      "properties": {
        "provenance": { "enum": ["documented", "local-structure-observation", "operator-attested", "fixture-claim", "native-claim", "rejected"] },
        "basis": { "enum": ["documentation", "structure", "attestation", "fixture-test", "native-test"] },
        "outcome": { "enum": ["supported", "unknown", "incompatible"] },
        "referenceId": { "$ref": "#/$defs/id" },
        "observedAt": { "$ref": "#/$defs/time" },
        "scopeSha256": { "$ref": "#/$defs/digest" },
        "definitionSha256": { "$ref": "#/$defs/digest" }
      }
    },
    "check": {
      "type": "object", "additionalProperties": false,
      "required": ["mechanismId", "methodId", "coverage", "containment", "evidence"],
      "properties": {
        "mechanismId": { "$ref": "#/$defs/mechanismId" },
        "methodId": { "$ref": "#/$defs/methodId" },
        "coverage": { "$ref": "#/$defs/phases" },
        "containment": { "enum": ["not-needed", "declared-contained", "unknown", "prohibited-effect-required"] },
        "evidence": { "anyOf": [{ "type": "null" }, { "$ref": "#/$defs/evidence" }] }
      }
    },
    "input": {
      "type": "object", "additionalProperties": false,
      "required": ["schemaVersion", "variant", "checks"],
      "properties": {
        "schemaVersion": { "const": "1.0.0" },
        "variant": { "$ref": "agent-client-isolated-variant.schema.json#/$defs/input" },
        "checks": { "type": "array", "maxItems": 12, "items": { "$ref": "#/$defs/check" } }
      }
    },
    "catalogCheck": {
      "type": "object", "additionalProperties": false,
      "required": ["mechanismId", "definitionSha256", "allowedMethods", "requiredCoverage"],
      "properties": {
        "mechanismId": { "$ref": "#/$defs/mechanismId" },
        "definitionSha256": { "$ref": "#/$defs/digest" },
        "allowedMethods": { "type": "array", "minItems": 1, "maxItems": 4, "uniqueItems": true, "items": { "$ref": "#/$defs/methodId" } },
        "requiredCoverage": { "type": "array", "minItems": 1, "maxItems": 3, "uniqueItems": true, "items": { "$ref": "#/$defs/phase" } }
      }
    },
    "catalog": {
      "type": "object", "additionalProperties": false,
      "required": ["catalogId", "variantSchema", "variantPolicy", "checks"],
      "properties": {
        "catalogId": { "$ref": "#/$defs/id" },
        "variantSchema": { "type": "object" },
        "variantPolicy": { "$ref": "agent-client-isolated-variant.schema.json#/$defs/policy" },
        "checks": { "type": "array", "minItems": 12, "maxItems": 12, "items": { "$ref": "#/$defs/catalogCheck" } }
      }
    },
    "row": {
      "type": "object", "additionalProperties": false,
      "required": ["mechanismId", "methodId", "state", "requiredCoverage", "missingCoverage", "missingEvidence", "reasons", "evidenceAuthenticated"],
      "properties": {
        "mechanismId": { "$ref": "#/$defs/mechanismId" },
        "methodId": { "anyOf": [{ "type": "null" }, { "$ref": "#/$defs/methodId" }] },
        "state": { "enum": ["documented-only", "structure-only", "test-scoped", "unresolved", "incompatible", "not-observable-in-scope"] },
        "requiredCoverage": { "$ref": "#/$defs/phases" },
        "missingCoverage": { "$ref": "#/$defs/phases" },
        "missingEvidence": { "type": "array", "maxItems": 16, "uniqueItems": true, "items": { "$ref": "#/$defs/id" } },
        "reasons": { "type": "array", "maxItems": 32, "uniqueItems": true, "items": { "$ref": "#/$defs/id" } },
        "evidenceAuthenticated": { "const": false }
      }
    },
    "report": {
      "type": "object", "additionalProperties": false,
      "required": ["scope", "state", "decision", "matrix", "reasons", "planSha256", "variantScopeSha256", "executed", "runtimeReady", "verifiedAdmission", "externalBillingVerified", "effectiveIsolationVerified"],
      "properties": {
        "scope": { "const": "isolated-verification-plan-only" },
        "state": { "enum": ["invalid", "blocked", "plan-review-required"] },
        "decision": { "const": "no-native-start" },
        "matrix": { "type": "array", "minItems": 12, "maxItems": 12, "items": { "$ref": "#/$defs/row" } },
        "reasons": { "type": "array", "minItems": 1, "maxItems": 64, "uniqueItems": true, "items": { "$ref": "#/$defs/id" } },
        "planSha256": { "anyOf": [{ "type": "null" }, { "$ref": "#/$defs/digest" }] },
        "variantScopeSha256": { "anyOf": [{ "type": "null" }, { "$ref": "#/$defs/digest" }] },
        "executed": { "const": false },
        "runtimeReady": { "const": false },
        "verifiedAdmission": { "const": false },
        "externalBillingVerified": { "const": false },
        "effectiveIsolationVerified": { "const": false }
      }
    }
  }
}
