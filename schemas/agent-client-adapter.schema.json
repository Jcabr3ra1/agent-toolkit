{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-toolkit.local/schemas/agent-client-adapter.schema.json",
  "title": "Client Adapter Planning v1",
  "description": "Contrato puro sin lanzamiento de clientes. Registros declarados, no permisos autenticados.",
  "$ref": "#/$defs/input",
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "maxLength": 128
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "maxLength": 20
    },
    "client": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider",
        "client",
        "variant",
        "clientVersion"
      ],
      "properties": {
        "provider": {
          "enum": [
            "openai",
            "anthropic"
          ]
        },
        "client": {
          "enum": [
            "codex-cli",
            "claude-code"
          ]
        },
        "variant": {
          "enum": [
            "codex-native",
            "claude-native"
          ]
        },
        "clientVersion": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[a-z0-9.-]+)?$",
          "maxLength": 64
        }
      }
    },
    "controls": {
      "type": "array",
      "minItems": 0,
      "maxItems": 7,
      "uniqueItems": true,
      "items": {
        "enum": [
          "no-tools",
          "no-subagents",
          "no-mcp",
          "no-hooks",
          "no-personalizations",
          "no-updates",
          "stdin-text"
        ]
      }
    },
    "record": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "recordId",
        "provider",
        "client",
        "variant",
        "clientVersion",
        "status",
        "supportedModels",
        "efforts",
        "roles",
        "controls",
        "evaluatedAt",
        "evidenceRefs"
      ],
      "properties": {
        "recordId": {
          "$ref": "#/$defs/id"
        },
        "provider": {
          "enum": [
            "openai",
            "anthropic"
          ]
        },
        "client": {
          "enum": [
            "codex-cli",
            "claude-code"
          ]
        },
        "variant": {
          "enum": [
            "codex-native",
            "claude-native"
          ]
        },
        "clientVersion": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[a-z0-9.-]+)?$",
          "maxLength": 64
        },
        "status": {
          "enum": [
            "evaluated",
            "pending",
            "disabled"
          ]
        },
        "supportedModels": {
          "type": "array",
          "minItems": 1,
          "maxItems": 128,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/id"
          }
        },
        "efforts": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/id"
          }
        },
        "roles": {
          "type": "array",
          "minItems": 1,
          "maxItems": 3,
          "uniqueItems": true,
          "items": {
            "enum": [
              "tutor",
              "proposer",
              "reviewer"
            ]
          }
        },
        "controls": {
          "$ref": "#/$defs/controls"
        },
        "evaluatedAt": {
          "$ref": "#/$defs/timestamp"
        },
        "evidenceRefs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/id"
          }
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "checkedAt",
        "evidenceRef"
      ],
      "properties": {
        "checkedAt": {
          "$ref": "#/$defs/timestamp"
        },
        "evidenceRef": {
          "$ref": "#/$defs/id"
        }
      }
    },
    "authorization": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "referenceId",
        "checkedAt",
        "evidenceRef"
      ],
      "properties": {
        "status": {
          "enum": [
            "approved",
            "pending",
            "denied",
            "unknown"
          ]
        },
        "referenceId": {
          "$ref": "#/$defs/id"
        },
        "checkedAt": {
          "$ref": "#/$defs/timestamp"
        },
        "evidenceRef": {
          "$ref": "#/$defs/id"
        }
      }
    },
    "context": {
      "type": "object",
      "additionalProperties": false,
      "required": [],
      "properties": {
        "scope": {
          "enum": [
            "text-only",
            "application"
          ]
        },
        "promptRef": {
          "$ref": "#/$defs/id"
        },
        "provenance": {
          "$ref": "#/$defs/provenance"
        },
        "authorization": {
          "$ref": "#/$defs/authorization"
        }
      }
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": [],
      "properties": {
        "access": {
          "enum": [
            "subscription-session",
            "unavailable",
            "unknown"
          ]
        },
        "externalBilling": {
          "enum": [
            "disabled",
            "enabled",
            "unknown"
          ]
        },
        "controls": {
          "$ref": "#/$defs/controls"
        },
        "checkedAt": {
          "$ref": "#/$defs/timestamp"
        },
        "evidenceRef": {
          "$ref": "#/$defs/id"
        }
      }
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "maxTurns",
        "timeoutSeconds",
        "maxOutputBytes",
        "maxLineBytes",
        "maxEvents",
        "maxStderrBytes"
      ],
      "properties": {
        "maxTurns": {
          "const": 1
        },
        "timeoutSeconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 86400
        },
        "maxOutputBytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1048576
        },
        "maxLineBytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65536
        },
        "maxEvents": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000
        },
        "maxStderrBytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65536
        }
      }
    },
    "registry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "registryId",
        "revision",
        "records"
      ],
      "properties": {
        "schemaVersion": {
          "const": "1.0.0"
        },
        "registryId": {
          "$ref": "#/$defs/id"
        },
        "revision": {
          "$ref": "#/$defs/id"
        },
        "records": {
          "type": "array",
          "minItems": 0,
          "maxItems": 64,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/record"
          }
        }
      }
    },
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "selection",
        "decision",
        "registry"
      ],
      "properties": {
        "schemaVersion": {
          "const": "1.0.0"
        },
        "selection": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "request",
            "catalog",
            "policy"
          ],
          "properties": {
            "request": {
              "$ref": "https://agent-toolkit.local/schemas/agent-model-preference.schema.json#/$defs/request"
            },
            "catalog": {
              "$ref": "https://agent-toolkit.local/schemas/agent-model-preference.schema.json#/$defs/catalog"
            },
            "policy": {
              "$ref": "https://agent-toolkit.local/schemas/agent-model-preference.schema.json#/$defs/policy"
            }
          }
        },
        "decision": {
          "type": "object",
          "description": "Se contrasta completo con la salida recalculada; no se confía en campos arbitrarios."
        },
        "adapter": {
          "$ref": "#/$defs/client"
        },
        "registry": {
          "$ref": "#/$defs/registry"
        },
        "context": {
          "$ref": "#/$defs/context"
        },
        "environment": {
          "$ref": "#/$defs/environment"
        },
        "limits": {
          "$ref": "#/$defs/limits"
        },
        "historyEvidence": {
          "$ref": "#/$defs/historyEvidence"
        }
      }
    },
    "intent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operation",
        "client",
        "profileId",
        "requestedModel",
        "requestedEffort",
        "arguments",
        "input",
        "authorizationRef",
        "compatibilityRecordId",
        "scope",
        "requiredControls",
        "limits",
        "budget",
        "automaticRetry",
        "allowProviderSwitch",
        "allowImplicitFallback"
      ],
      "properties": {
        "operation": {
          "const": "text-response"
        },
        "client": {
          "$ref": "#/$defs/client"
        },
        "profileId": {
          "$ref": "#/$defs/id"
        },
        "requestedModel": {
          "$ref": "#/$defs/id"
        },
        "requestedEffort": {
          "$ref": "#/$defs/id"
        },
        "arguments": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "value"
            ],
            "properties": {
              "name": {
                "enum": [
                  "model",
                  "effort"
                ]
              },
              "value": {
                "$ref": "#/$defs/id"
              }
            }
          }
        },
        "input": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "transport",
            "promptRef",
            "provenance"
          ],
          "properties": {
            "transport": {
              "const": "stdin-text"
            },
            "promptRef": {
              "$ref": "#/$defs/id"
            },
            "provenance": {
              "$ref": "#/$defs/provenance"
            }
          }
        },
        "authorizationRef": {
          "$ref": "#/$defs/id"
        },
        "compatibilityRecordId": {
          "$ref": "#/$defs/id"
        },
        "scope": {
          "const": "text-only"
        },
        "requiredControls": {
          "$ref": "#/$defs/controls"
        },
        "limits": {
          "$ref": "#/$defs/limits"
        },
        "budget": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "executionsRemaining",
            "durationRemainingSeconds",
            "history"
          ],
          "properties": {
            "executionsRemaining": {
              "type": "integer",
              "minimum": 1
            },
            "durationRemainingSeconds": {
              "type": "integer",
              "minimum": 1
            },
            "history": {
              "$ref": "https://agent-toolkit.local/schemas/agent-model-preference.schema.json#/$defs/history"
            }
          }
        },
        "automaticRetry": {
          "const": false
        },
        "allowProviderSwitch": {
          "const": false
        },
        "allowImplicitFallback": {
          "const": false
        }
      }
    },
    "report": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "plannerVersion",
        "state",
        "executed",
        "runtimeReady",
        "identity",
        "intent",
        "observedModels",
        "modelVerification",
        "observedEffort",
        "effortVerification",
        "reasons",
        "missing",
        "selectorState",
        "externalGates",
        "audit"
      ],
      "properties": {
        "schemaVersion": {
          "const": "1.0.0"
        },
        "plannerVersion": {
          "const": "1.0.0"
        },
        "state": {
          "enum": [
            "invalid",
            "needs-info",
            "blocked",
            "prepared"
          ]
        },
        "executed": {
          "const": false
        },
        "runtimeReady": {
          "const": false
        },
        "identity": {
          "anyOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "projectId",
                "taskId",
                "revision",
                "role",
                "mode"
              ],
              "properties": {
                "projectId": {
                  "$ref": "https://agent-toolkit.local/schemas/agent-model-selection.schema.json#/$defs/id"
                },
                "taskId": {
                  "$ref": "https://agent-toolkit.local/schemas/agent-model-selection.schema.json#/$defs/id"
                },
                "revision": {
                  "$ref": "https://agent-toolkit.local/schemas/agent-model-selection.schema.json#/$defs/id"
                },
                "role": {
                  "enum": [
                    "coordinator",
                    "tutor",
                    "proposer",
                    "reviewer",
                    "executor"
                  ]
                },
                "mode": {
                  "enum": [
                    "tutor",
                    "autonomous"
                  ]
                }
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "intent": {
          "anyOf": [
            {
              "$ref": "#/$defs/intent"
            },
            {
              "type": "null"
            }
          ]
        },
        "observedModels": {
          "type": "array",
          "maxItems": 0
        },
        "modelVerification": {
          "const": "unknown"
        },
        "observedEffort": {
          "type": "null"
        },
        "effortVerification": {
          "const": "unknown"
        },
        "reasons": {
          "type": "array",
          "minItems": 0,
          "maxItems": 128,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/id"
          }
        },
        "missing": {
          "type": "array",
          "minItems": 0,
          "maxItems": 128,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/id"
          }
        },
        "selectorState": {
          "anyOf": [
            {
              "enum": [
                "recommended",
                "invalid",
                "needs-info",
                "blocked"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "externalGates": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/id"
          }
        },
        "audit": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "adapterSchemaSha256",
            "inputSha256",
            "registrySha256",
            "decisionSha256"
          ],
          "properties": {
            "adapterSchemaSha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "inputSha256": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                },
                {
                  "type": "null"
                }
              ]
            },
            "registrySha256": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                },
                {
                  "type": "null"
                }
              ]
            },
            "decisionSha256": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                },
                {
                  "type": "null"
                }
              ]
            }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "state": {
                "const": "prepared"
              }
            },
            "required": [
              "state"
            ]
          },
          "then": {
            "properties": {
              "intent": {
                "$ref": "#/$defs/intent"
              },
              "identity": {
                "type": "object"
              }
            }
          },
          "else": {
            "properties": {
              "intent": {
                "type": "null"
              }
            }
          }
        }
      ]
    },
    "historyEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "history",
        "checkedAt",
        "evidenceRef"
      ],
      "properties": {
        "status": {
          "enum": [
            "reconciled",
            "pending",
            "unknown"
          ]
        },
        "history": {
          "$ref": "https://agent-toolkit.local/schemas/agent-model-preference.schema.json#/$defs/history"
        },
        "checkedAt": {
          "$ref": "#/$defs/timestamp"
        },
        "evidenceRef": {
          "$ref": "#/$defs/id"
        }
      }
    }
  }
}
