{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-toolkit.local/schemas/agent-task-verify.schema.json",
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9](?:[a-z0-9._-]{0,62}[a-z0-9])?$" },
    "revision": { "type": "string", "pattern": "^r[0-9]{2,4}$" },
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "nullableSha256": { "anyOf": [{ "$ref": "#/$defs/sha256" }, { "type": "null" }] },
    "phase": { "enum": ["before", "after"] },
    "root": { "enum": ["source", "handoff"] },
    "operation": { "enum": ["inspect", "modify", "create", "delete"] },
    "reason": { "type": "string", "pattern": "^verify-[a-z0-9-]{1,80}$" },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["projectId", "taskId", "revision"],
      "properties": {
        "projectId": { "$ref": "#/$defs/id" },
        "taskId": { "$ref": "#/$defs/id" },
        "revision": { "$ref": "#/$defs/revision" }
      }
    },
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "root", "path", "operation", "before", "after"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "root": { "$ref": "#/$defs/root" },
        "path": { "type": "string", "minLength": 1, "maxLength": 512 },
        "operation": { "$ref": "#/$defs/operation" },
        "before": { "$ref": "#/$defs/nullableSha256" },
        "after": { "$ref": "#/$defs/nullableSha256" }
      },
      "allOf": [
        {
          "if": { "properties": { "operation": { "const": "inspect" } } },
          "then": { "properties": { "before": { "$ref": "#/$defs/sha256" }, "after": { "$ref": "#/$defs/sha256" } } }
        },
        {
          "if": { "properties": { "operation": { "const": "modify" } } },
          "then": { "properties": { "before": { "$ref": "#/$defs/sha256" }, "after": { "$ref": "#/$defs/sha256" } } }
        },
        {
          "if": { "properties": { "operation": { "const": "create" } } },
          "then": { "properties": { "before": { "type": "null" }, "after": { "$ref": "#/$defs/sha256" } } }
        },
        {
          "if": { "properties": { "operation": { "const": "delete" } } },
          "then": { "properties": { "before": { "$ref": "#/$defs/sha256" }, "after": { "type": "null" } } }
        }
      ]
    },
    "contract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "schemaVersion", "identity", "scope", "entries"],
      "properties": {
        "kind": { "const": "agent-task-verify-contract" },
        "schemaVersion": { "const": "1.0.0" },
        "identity": { "$ref": "#/$defs/identity" },
        "scope": { "const": "listed-files-only" },
        "entries": { "type": "array", "minItems": 1, "maxItems": 128, "items": { "$ref": "#/$defs/entry" } }
      }
    },
    "observation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "status", "sha256"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "status": { "enum": ["present", "absent", "blocked"] },
        "sha256": { "$ref": "#/$defs/nullableSha256" }
      },
      "allOf": [
        {
          "if": { "properties": { "status": { "enum": ["absent", "blocked"] } } },
          "then": { "properties": { "sha256": { "type": "null" } } }
        }
      ]
    },
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contract", "phase", "observations"],
      "properties": {
        "contract": { "type": "object" },
        "phase": { "$ref": "#/$defs/phase" },
        "observations": { "type": "array", "maxItems": 128, "items": { "$ref": "#/$defs/observation" } }
      }
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "root", "operation", "outcome", "expected", "observed"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "root": { "$ref": "#/$defs/root" },
        "operation": { "$ref": "#/$defs/operation" },
        "outcome": { "enum": ["matched-hash", "matched-absent", "hash-differs", "missing", "unexpected-present"] },
        "expected": { "$ref": "#/$defs/nullableSha256" },
        "observed": { "$ref": "#/$defs/nullableSha256" }
      }
    },
    "audit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["verifySchemaSha256", "contractSha256", "contractByteSha256", "expectedPinSha256"],
      "properties": {
        "verifySchemaSha256": { "$ref": "#/$defs/sha256" },
        "contractSha256": { "$ref": "#/$defs/nullableSha256" },
        "contractByteSha256": { "$ref": "#/$defs/nullableSha256" },
        "expectedPinSha256": { "$ref": "#/$defs/nullableSha256" }
      }
    },
    "report": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "command", "schemaVersion", "state", "phase", "identity", "provenance", "results", "reasons", "audit",
        "scopeCoverage", "unlistedChangesVerified", "contentQualityVerified", "testsExecuted", "permissionVerified",
        "approvalGranted", "gitStateVerified", "modelVerified", "nativeAdmission", "runtimeReady",
        "wrote", "sent", "executed", "humanReviewRequired"
      ],
      "properties": {
        "command": { "const": "agent-task verify" },
        "schemaVersion": { "const": "1.0.0" },
        "state": { "enum": ["matched", "mismatched", "blocked", "invalid"] },
        "phase": { "anyOf": [{ "$ref": "#/$defs/phase" }, { "type": "null" }] },
        "identity": { "anyOf": [{ "$ref": "#/$defs/identity" }, { "type": "null" }] },
        "provenance": { "enum": ["none", "declared-observations", "local-read"] },
        "results": { "type": "array", "maxItems": 128, "items": { "$ref": "#/$defs/result" } },
        "reasons": { "type": "array", "minItems": 1, "maxItems": 16, "uniqueItems": true, "items": { "$ref": "#/$defs/reason" } },
        "audit": { "$ref": "#/$defs/audit" },
        "scopeCoverage": { "const": "listed-files-only" },
        "unlistedChangesVerified": { "const": false },
        "contentQualityVerified": { "const": false },
        "testsExecuted": { "const": false },
        "permissionVerified": { "const": false },
        "approvalGranted": { "const": false },
        "gitStateVerified": { "const": false },
        "modelVerified": { "const": false },
        "nativeAdmission": { "const": false },
        "runtimeReady": { "const": false },
        "wrote": { "const": false },
        "sent": { "const": false },
        "executed": { "const": false },
        "humanReviewRequired": { "const": true }
      },
      "allOf": [
        {
          "if": { "properties": { "state": { "enum": ["matched", "mismatched"] } } },
          "then": {
            "properties": {
              "provenance": { "enum": ["declared-observations", "local-read"] },
              "results": { "type": "array", "minItems": 1 },
              "identity": { "$ref": "#/$defs/identity" },
              "phase": { "$ref": "#/$defs/phase" },
              "audit": { "type": "object", "properties": { "contractSha256": { "$ref": "#/$defs/sha256" } } }
            }
          },
          "else": {
            "properties": {
              "provenance": { "const": "none" },
              "results": { "type": "array", "maxItems": 0 }
            }
          }
        },
        {
          "if": { "properties": { "provenance": { "const": "local-read" } } },
          "then": {
            "properties": {
              "audit": {
                "type": "object",
                "properties": {
                  "contractByteSha256": { "$ref": "#/$defs/sha256" },
                  "expectedPinSha256": { "$ref": "#/$defs/sha256" }
                }
              }
            }
          }
        },
        {
          "if": { "properties": { "state": { "const": "matched" } } },
          "then": {
            "properties": {
              "reasons": { "type": "array", "contains": { "const": "verify-matched" } },
              "results": {
                "type": "array",
                "items": { "type": "object", "properties": { "outcome": { "enum": ["matched-hash", "matched-absent"] } } }
              }
            }
          }
        }
      ]
    }
  }
}
