{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-toolkit.local/schemas/agent-task-approvals.schema.json",
  "title": "RA-A declared task approvals, not execution permission",
  "$ref": "#/$defs/replayInput",
  "$defs": {
    "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$", "maxLength": 128 },
    "nullableId": { "anyOf": [{ "$ref": "#/$defs/id" }, { "type": "null" }] },
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "nullableSha256": { "anyOf": [{ "$ref": "#/$defs/sha256" }, { "type": "null" }] },
    "timestamp": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$", "maxLength": 20 },
    "action": { "type": "string", "enum": ["read", "modify", "create"] },
    "effect": { "type": "string", "enum": ["workspace-write", "test-execution", "client-start", "inference"] },
    "pathAction": {
      "type": "object", "additionalProperties": false, "required": ["path", "action"],
      "properties": { "path": { "type": "string", "minLength": 1, "maxLength": 256 }, "action": { "$ref": "#/$defs/action" } }
    },
    "items": { "type": "array", "minItems": 1, "maxItems": 64, "items": { "$ref": "#/$defs/pathAction" } },
    "checks": { "type": "array", "maxItems": 32, "uniqueItems": true, "items": { "$ref": "#/$defs/id" } },
    "effects": { "type": "array", "maxItems": 4, "uniqueItems": true, "items": { "$ref": "#/$defs/effect" } },
    "recipient": {
      "type": "object", "additionalProperties": false, "required": ["client", "role", "mode"],
      "properties": {
        "client": { "$ref": "#/$defs/id" }, "role": { "$ref": "#/$defs/id" },
        "mode": { "$ref": "#/$defs/id" }
      }
    },
    "limits": {
      "type": "object", "additionalProperties": false, "required": ["maxOperations", "maxRetries", "maxCorrections"],
      "properties": {
        "maxOperations": { "type": "integer", "minimum": 1, "maximum": 100 },
        "maxRetries": { "type": "integer", "minimum": 0, "maximum": 100 },
        "maxCorrections": { "type": "integer", "minimum": 0, "maximum": 100 }
      }
    },
    "scope": {
      "type": "object", "additionalProperties": false,
      "required": ["projectId", "taskId", "recipient", "paths", "checks", "effects", "limits", "validFrom", "expiresAt"],
      "properties": {
        "projectId": { "$ref": "#/$defs/id" }, "taskId": { "$ref": "#/$defs/id" },
        "recipient": { "$ref": "#/$defs/recipient" }, "paths": { "$ref": "#/$defs/items" },
        "checks": { "$ref": "#/$defs/checks" }, "effects": { "$ref": "#/$defs/effects" },
        "limits": { "$ref": "#/$defs/limits" },
        "validFrom": { "$ref": "#/$defs/timestamp" }, "expiresAt": { "$ref": "#/$defs/timestamp" }
      }
    },
    "artifact": {
      "type": "object", "additionalProperties": false, "required": ["revision", "sha256", "qualityReviewRef"],
      "properties": {
        "revision": { "$ref": "#/$defs/id" }, "sha256": { "$ref": "#/$defs/sha256" },
        "qualityReviewRef": { "$ref": "#/$defs/id" }
      }
    },
    "artifactRef": {
      "type": "object", "additionalProperties": false, "required": ["revision", "sha256"],
      "properties": { "revision": { "$ref": "#/$defs/id" }, "sha256": { "$ref": "#/$defs/sha256" } }
    },
    "baseBinding": {
      "type": "object", "additionalProperties": false, "required": ["initialSha256", "transitions"],
      "properties": {
        "initialSha256": { "$ref": "#/$defs/sha256" },
        "transitions": {
          "type": "array", "maxItems": 64,
          "items": {
            "type": "object", "additionalProperties": false, "required": ["fromSha256", "toSha256"],
            "properties": { "fromSha256": { "$ref": "#/$defs/sha256" }, "toSha256": { "$ref": "#/$defs/sha256" } }
          }
        }
      }
    },
    "nonStartEvidence": {
      "type": "object", "additionalProperties": false,
      "required": ["reservationEventId", "priorEventId", "previousState", "decisionRef", "observation", "inspectedBaseSha256", "evidenceRef"],
      "properties": {
        "reservationEventId": { "$ref": "#/$defs/id" }, "priorEventId": { "$ref": "#/$defs/id" },
        "previousState": { "type": "string", "enum": ["reserved", "indeterminate"] },
        "decisionRef": { "$ref": "#/$defs/id" },
        "observation": { "const": "non-start-confirmed" },
        "inspectedBaseSha256": { "$ref": "#/$defs/sha256" }, "evidenceRef": { "$ref": "#/$defs/id" }
      }
    },
    "terminationEvidence": {
      "type": "object", "additionalProperties": false,
      "required": ["reservationEventId", "priorEventId", "previousState", "decisionRef", "observation", "evidenceRef"],
      "properties": {
        "reservationEventId": { "$ref": "#/$defs/id" }, "priorEventId": { "$ref": "#/$defs/id" },
        "previousState": { "type": "string", "enum": ["reserved", "started", "indeterminate"] },
        "decisionRef": { "$ref": "#/$defs/id" },
        "observation": { "const": "termination-observed" }, "evidenceRef": { "$ref": "#/$defs/id" }
      }
    },
    "event": {
      "oneOf": [
        {
          "type": "object", "additionalProperties": false,
          "required": ["eventId", "type", "requestId", "at", "scopeSha256", "scope", "artifact", "baseBinding"],
          "properties": {
            "eventId": { "$ref": "#/$defs/id" }, "type": { "const": "request" }, "requestId": { "$ref": "#/$defs/id" },
            "at": { "$ref": "#/$defs/timestamp" }, "scopeSha256": { "$ref": "#/$defs/sha256" },
            "scope": { "$ref": "#/$defs/scope" }, "artifact": { "$ref": "#/$defs/artifact" },
            "baseBinding": { "$ref": "#/$defs/baseBinding" }
          }
        },
        {
          "type": "object", "additionalProperties": false,
          "required": ["eventId", "type", "requestId", "at", "decision", "requestSha256", "responseRef"],
          "properties": {
            "eventId": { "$ref": "#/$defs/id" }, "type": { "const": "decision" }, "requestId": { "$ref": "#/$defs/id" },
            "at": { "$ref": "#/$defs/timestamp" }, "decision": { "type": "string", "enum": ["approve", "deny"] },
            "requestSha256": { "$ref": "#/$defs/sha256" }, "responseRef": { "$ref": "#/$defs/id" }
          }
        },
        {
          "type": "object", "additionalProperties": false,
          "required": ["eventId", "type", "requestId", "at", "scopeSha256", "previousRevision", "artifact"],
          "properties": {
            "eventId": { "$ref": "#/$defs/id" }, "type": { "const": "correction" }, "requestId": { "$ref": "#/$defs/id" },
            "at": { "$ref": "#/$defs/timestamp" }, "scopeSha256": { "$ref": "#/$defs/sha256" },
            "previousRevision": { "$ref": "#/$defs/id" }, "artifact": { "$ref": "#/$defs/artifact" }
          }
        },
        {
          "type": "object", "additionalProperties": false,
          "required": ["eventId", "type", "requestId", "at", "operationId", "retryOf", "artifactRevision", "expectedBaseSha256", "items", "checks", "effects"],
          "properties": {
            "eventId": { "$ref": "#/$defs/id" }, "type": { "const": "reserve" }, "requestId": { "$ref": "#/$defs/id" },
            "at": { "$ref": "#/$defs/timestamp" }, "operationId": { "$ref": "#/$defs/id" },
            "retryOf": { "$ref": "#/$defs/nullableId" }, "artifactRevision": { "$ref": "#/$defs/id" },
            "expectedBaseSha256": { "$ref": "#/$defs/sha256" }, "items": { "$ref": "#/$defs/items" },
            "checks": { "$ref": "#/$defs/checks" }, "effects": { "$ref": "#/$defs/effects" }
          }
        },
        {
          "type": "object", "additionalProperties": false,
          "required": ["eventId", "type", "requestId", "at", "operationId"],
          "properties": {
            "eventId": { "$ref": "#/$defs/id" }, "type": { "const": "start" }, "requestId": { "$ref": "#/$defs/id" },
            "at": { "$ref": "#/$defs/timestamp" }, "operationId": { "$ref": "#/$defs/id" }
          }
        },
        {
          "type": "object", "additionalProperties": false,
          "required": ["eventId", "type", "requestId", "at", "operationId", "evidenceRef"],
          "properties": {
            "eventId": { "$ref": "#/$defs/id" }, "type": { "const": "interrupt" }, "requestId": { "$ref": "#/$defs/id" },
            "at": { "$ref": "#/$defs/timestamp" }, "operationId": { "$ref": "#/$defs/id" },
            "evidenceRef": { "$ref": "#/$defs/id" }
          }
        },
        {
          "type": "object", "additionalProperties": false,
          "required": ["eventId", "type", "requestId", "at", "operationId", "outcome", "resultingBaseSha256", "evidenceRef"],
          "properties": {
            "eventId": { "$ref": "#/$defs/id" }, "type": { "const": "result" }, "requestId": { "$ref": "#/$defs/id" },
            "at": { "$ref": "#/$defs/timestamp" }, "operationId": { "$ref": "#/$defs/id" },
            "outcome": { "type": "string", "enum": ["succeeded", "failed"] },
            "resultingBaseSha256": { "$ref": "#/$defs/nullableSha256" }, "evidenceRef": { "$ref": "#/$defs/id" }
          }
        },
        {
          "type": "object", "additionalProperties": false,
          "required": ["eventId", "type", "requestId", "at", "operationId", "resolution", "resultingBaseSha256", "evidence"],
          "properties": {
            "eventId": { "$ref": "#/$defs/id" }, "type": { "const": "reconcile" }, "requestId": { "$ref": "#/$defs/id" },
            "at": { "$ref": "#/$defs/timestamp" }, "operationId": { "$ref": "#/$defs/id" },
            "resolution": { "type": "string", "enum": ["not-started-confirmed", "finished-succeeded", "finished-failed"] },
            "resultingBaseSha256": { "$ref": "#/$defs/nullableSha256" },
            "evidence": { "oneOf": [{ "$ref": "#/$defs/nonStartEvidence" }, { "$ref": "#/$defs/terminationEvidence" }] }
          }
        },
        {
          "type": "object", "additionalProperties": false,
          "required": ["eventId", "type", "requestId", "at", "responseRef"],
          "properties": {
            "eventId": { "$ref": "#/$defs/id" }, "type": { "const": "revoke" }, "requestId": { "$ref": "#/$defs/id" },
            "at": { "$ref": "#/$defs/timestamp" }, "responseRef": { "$ref": "#/$defs/id" }
          }
        },
        {
          "type": "object", "additionalProperties": false,
          "required": ["eventId", "type", "requestId", "at", "reason"],
          "properties": {
            "eventId": { "$ref": "#/$defs/id" }, "type": { "const": "close" }, "requestId": { "$ref": "#/$defs/id" },
            "at": { "$ref": "#/$defs/timestamp" },
            "reason": { "type": "string", "enum": ["completed", "superseded", "cancelled"] }
          }
        }
      ]
    },
    "history": {
      "type": "object", "additionalProperties": false, "required": ["projectId", "taskId", "events"],
      "properties": {
        "projectId": { "$ref": "#/$defs/id" }, "taskId": { "$ref": "#/$defs/id" },
        "events": { "type": "array", "maxItems": 256, "items": { "$ref": "#/$defs/event" } }
      }
    },
    "checkpoint": {
      "type": "object", "additionalProperties": false, "required": ["revision", "historySha256"],
      "properties": {
        "revision": { "type": "integer", "minimum": 0, "maximum": 256 },
        "historySha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "query": {
      "type": "object", "additionalProperties": false,
      "required": ["requestId", "operationId", "recipient", "items", "checks", "effects", "observedBaseSha256", "artifact", "retryOf"],
      "properties": {
        "requestId": { "$ref": "#/$defs/id" }, "operationId": { "$ref": "#/$defs/nullableId" },
        "recipient": { "$ref": "#/$defs/recipient" }, "items": { "$ref": "#/$defs/items" },
        "checks": { "$ref": "#/$defs/checks" }, "effects": { "$ref": "#/$defs/effects" },
        "observedBaseSha256": { "$ref": "#/$defs/sha256" }, "artifact": { "$ref": "#/$defs/artifactRef" },
        "retryOf": { "$ref": "#/$defs/nullableId" }
      }
    },
    "replayInput": {
      "type": "object", "additionalProperties": false, "required": ["schemaVersion", "history", "checkpoint"],
      "properties": {
        "schemaVersion": { "const": "1.0.0" }, "history": { "$ref": "#/$defs/history" },
        "checkpoint": { "$ref": "#/$defs/checkpoint" }
      }
    },
    "proposeInput": {
      "type": "object", "additionalProperties": false, "required": ["schemaVersion", "history", "checkpoint", "event"],
      "properties": {
        "schemaVersion": { "const": "1.0.0" }, "history": { "$ref": "#/$defs/history" },
        "checkpoint": { "$ref": "#/$defs/checkpoint" }, "event": { "$ref": "#/$defs/event" }
      }
    },
    "coverInput": {
      "type": "object", "additionalProperties": false, "required": ["schemaVersion", "history", "checkpoint", "now", "query"],
      "properties": {
        "schemaVersion": { "const": "1.0.0" }, "history": { "$ref": "#/$defs/history" },
        "checkpoint": { "$ref": "#/$defs/checkpoint" }, "now": { "$ref": "#/$defs/timestamp" },
        "query": { "$ref": "#/$defs/query" }
      }
    },
    "remaining": {
      "type": "object", "additionalProperties": false, "required": ["operations", "corrections", "retries"],
      "properties": {
        "operations": { "type": "integer", "minimum": 0, "maximum": 100 },
        "corrections": { "type": "integer", "minimum": 0, "maximum": 100 },
        "retries": { "type": "integer", "minimum": 0, "maximum": 100 }
      }
    },
    "operationSummary": {
      "type": "object", "additionalProperties": false, "required": ["operationId", "state", "reserveEventId", "retryOf"],
      "properties": {
        "operationId": { "$ref": "#/$defs/id" },
        "state": { "type": "string", "enum": ["reserved", "started", "indeterminate", "succeeded", "failed", "released-declared"] },
        "reserveEventId": { "$ref": "#/$defs/id" }, "retryOf": { "$ref": "#/$defs/nullableId" }
      }
    },
    "requestSummary": {
      "type": "object", "additionalProperties": false,
      "required": ["requestId", "status", "scopeSha256", "requestSha256", "artifact", "baseSha256", "divergedBaseSha256", "corrections", "retries", "usedOperations", "remaining", "operations"],
      "properties": {
        "requestId": { "$ref": "#/$defs/id" },
        "status": { "type": "string", "enum": ["pending", "approved", "denied", "revoked", "closed"] },
        "scopeSha256": { "$ref": "#/$defs/sha256" }, "requestSha256": { "$ref": "#/$defs/sha256" },
        "artifact": { "$ref": "#/$defs/artifact" }, "baseSha256": { "$ref": "#/$defs/sha256" },
        "divergedBaseSha256": { "$ref": "#/$defs/nullableSha256" },
        "corrections": { "type": "integer", "minimum": 0, "maximum": 100 },
        "retries": { "type": "integer", "minimum": 0, "maximum": 100 },
        "usedOperations": { "type": "integer", "minimum": 0, "maximum": 100 },
        "remaining": { "$ref": "#/$defs/remaining" },
        "operations": { "type": "array", "maxItems": 256, "items": { "$ref": "#/$defs/operationSummary" } }
      }
    },
    "view": {
      "type": "object", "additionalProperties": false,
      "required": ["revision", "historySha256", "duplicatesIgnored", "lastEventAt", "requests"],
      "properties": {
        "revision": { "type": "integer", "minimum": 0, "maximum": 256 },
        "historySha256": { "$ref": "#/$defs/sha256" },
        "duplicatesIgnored": { "type": "integer", "minimum": 0, "maximum": 256 },
        "lastEventAt": { "anyOf": [{ "$ref": "#/$defs/timestamp" }, { "type": "null" }] },
        "requests": { "type": "array", "maxItems": 256, "items": { "$ref": "#/$defs/requestSummary" } }
      }
    },
    "proposal": {
      "type": "object", "additionalProperties": false, "required": ["event", "nextRevision", "nextHistorySha256"],
      "properties": {
        "event": { "$ref": "#/$defs/event" }, "nextRevision": { "type": "integer", "minimum": 1, "maximum": 256 },
        "nextHistorySha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "report": {
      "type": "object", "additionalProperties": false,
      "required": ["schemaVersion", "engineVersion", "operation", "state", "reasons", "authorityVerified", "executionAuthorized", "persisted", "nativeExecuted", "requestId", "revision", "historySha256", "view", "remaining", "proposal"],
      "properties": {
        "schemaVersion": { "const": "1.0.0" }, "engineVersion": { "const": "1.0.0" },
        "operation": { "type": "string", "enum": ["replay", "propose", "cover"] },
        "state": {
          "type": "string",
          "enum": ["reduced", "proposed", "noop", "declared-covered", "approval-needed", "blocked", "reconciliation-required", "invalid"]
        },
        "reasons": {
          "type": "array", "minItems": 1, "maxItems": 1,
          "items": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$" }
        },
        "authorityVerified": { "type": "boolean", "const": false },
        "executionAuthorized": { "type": "boolean", "const": false },
        "persisted": { "type": "boolean", "const": false },
        "nativeExecuted": { "type": "boolean", "const": false },
        "requestId": { "$ref": "#/$defs/nullableId" },
        "revision": { "anyOf": [{ "type": "integer", "minimum": 0, "maximum": 256 }, { "type": "null" }] },
        "historySha256": { "$ref": "#/$defs/nullableSha256" },
        "view": { "anyOf": [{ "$ref": "#/$defs/view" }, { "type": "null" }] },
        "remaining": { "anyOf": [{ "$ref": "#/$defs/remaining" }, { "type": "null" }] },
        "proposal": { "anyOf": [{ "$ref": "#/$defs/proposal" }, { "type": "null" }] }
      },
      "allOf": [
        {
          "if": { "type": "object", "properties": { "state": { "const": "reduced" } }, "required": ["state"] },
          "then": {
            "type": "object",
            "properties": {
              "operation": { "const": "replay" }, "view": { "$ref": "#/$defs/view" },
              "proposal": { "type": "null" }, "remaining": { "type": "null" }
            }
          }
        },
        {
          "if": { "type": "object", "properties": { "state": { "const": "proposed" } }, "required": ["state"] },
          "then": {
            "type": "object",
            "properties": {
              "operation": { "const": "propose" }, "proposal": { "$ref": "#/$defs/proposal" },
              "view": { "type": "null" }, "remaining": { "type": "null" }
            }
          }
        },
        {
          "if": { "type": "object", "properties": { "state": { "const": "noop" } }, "required": ["state"] },
          "then": { "type": "object", "properties": { "operation": { "const": "propose" } } }
        },
        {
          "if": {
            "type": "object", "required": ["state"],
            "properties": { "state": { "enum": ["declared-covered", "approval-needed", "reconciliation-required"] } }
          },
          "then": { "type": "object", "properties": { "operation": { "const": "cover" } } }
        },
        {
          "if": { "type": "object", "properties": { "state": { "const": "declared-covered" } }, "required": ["state"] },
          "then": { "type": "object", "properties": { "remaining": { "$ref": "#/$defs/remaining" } } }
        },
        {
          "if": {
            "type": "object", "required": ["state"],
            "properties": { "state": { "enum": ["noop", "declared-covered", "approval-needed", "reconciliation-required", "blocked", "invalid"] } }
          },
          "then": { "type": "object", "properties": { "view": { "type": "null" }, "proposal": { "type": "null" } } }
        },
        {
          "if": { "type": "object", "properties": { "operation": { "enum": ["replay", "propose"] } }, "required": ["operation"] },
          "then": { "type": "object", "properties": { "remaining": { "type": "null" } } }
        }
      ]
    }
  }
}
