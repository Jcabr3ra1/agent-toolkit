{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Project Memory Update Proposal",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "projectId", "repository", "reviewBranch", "pr", "mergeCommit", "memoryHead", "manifestSha256", "notes"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "projectId": { "type": "string", "minLength": 2, "maxLength": 64, "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$" },
    "repository": { "type": "string", "maxLength": 200, "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$" },
    "reviewBranch": { "type": "string", "minLength": 1, "maxLength": 255 },
    "pr": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
    "mergeCommit": { "$ref": "#/$defs/gitSha" },
    "memoryHead": { "$ref": "#/$defs/gitSha" },
    "manifestSha256": { "$ref": "#/$defs/sha256" },
    "notes": { "type": "array", "minItems": 1, "maxItems": 20, "items": { "$ref": "#/$defs/note" } }
  },
  "$defs": {
    "gitSha": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "relativePath": { "type": "string", "minLength": 1, "maxLength": 512 },
    "note": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "beforeSha256", "content", "sourcePaths"],
      "properties": {
        "path": { "$ref": "#/$defs/relativePath" },
        "beforeSha256": { "$ref": "#/$defs/sha256" },
        "content": { "type": "string", "minLength": 1, "maxLength": 1048576 },
        "sourcePaths": { "type": "array", "minItems": 1, "maxItems": 20, "uniqueItems": true, "items": { "$ref": "#/$defs/relativePath" } }
      }
    }
  }
}
