{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-toolkit.local/schemas/agent-client-supervised.schema.json",
  "title": "Supervised subscription declarations, not execution permission",
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,95}$" },
    "sha": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "nullableId": { "anyOf": [{ "$ref": "#/$defs/id" }, { "type": "null" }] },
    "date": { "type": "string", "format": "date-time" },
    "assessment": {
      "type": "object", "additionalProperties": false,
      "required": ["status", "source", "checkedAt", "expiresAt", "evidenceRef", "scopeSha256"],
      "properties": {
        "status": { "enum": ["confirmed", "documented", "pending", "rejected"] },
        "source": { "enum": ["operator-attestation", "installation-test", "provider-documentation"] },
        "checkedAt": { "$ref": "#/$defs/date" }, "expiresAt": { "$ref": "#/$defs/date" },
        "evidenceRef": { "$ref": "#/$defs/nullableId" }, "scopeSha256": { "$ref": "#/$defs/sha" }
      }
    },
    "identity": {
      "type": "object", "additionalProperties": false,
      "required": ["projectId", "taskId", "taskRevision", "role", "mode"],
      "properties": {
        "projectId": { "$ref": "#/$defs/id" }, "taskId": { "$ref": "#/$defs/id" },
        "taskRevision": { "type": "integer", "minimum": 1, "maximum": 1000000 },
        "role": { "enum": ["tutor", "proposer", "reviewer"] }, "mode": { "enum": ["tutor", "autonomous"] }
      }
    },
    "selection": {
      "type": "object", "additionalProperties": false,
      "required": ["provider", "client", "profileId", "model", "effort", "source", "assessment"],
      "properties": {
        "provider": { "const": "anthropic" }, "client": { "const": "claude-code" },
        "profileId": { "$ref": "#/$defs/id" }, "model": { "$ref": "#/$defs/id" },
        "effort": { "enum": ["low", "medium", "high", "xhigh", "max"] },
        "source": { "enum": ["operator-choice", "selector-recommendation"] },
        "assessment": { "$ref": "#/$defs/assessment" }
      }
    },
    "binding": {
      "type": "object", "additionalProperties": false,
      "required": ["provider", "client", "variantId", "clientVersion", "platform", "architecture", "installationId", "artifactSha256", "configurationSha256", "environmentSha256", "controlRevision"],
      "properties": {
        "provider": { "const": "anthropic" }, "client": { "const": "claude-code" },
        "variantId": { "$ref": "#/$defs/id" },
        "clientVersion": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[a-z0-9.-]+)?$", "maxLength": 64 },
        "platform": { "enum": ["darwin", "linux", "win32"] }, "architecture": { "enum": ["arm64", "x64"] },
        "installationId": { "$ref": "#/$defs/id" }, "artifactSha256": { "$ref": "#/$defs/sha" },
        "configurationSha256": { "$ref": "#/$defs/sha" }, "environmentSha256": { "$ref": "#/$defs/sha" },
        "controlRevision": { "$ref": "#/$defs/id" }
      }
    },
    "limits": {
      "type": "object", "additionalProperties": false,
      "required": ["maxMainStarts", "maxConcurrent", "maxRetries", "maxCorrections", "timeoutSeconds", "terminationGraceSeconds", "maxInputBytes", "maxStdoutBytes", "maxStderrBytes", "maxEventBytes", "maxEvents", "maxNativeTurns"],
      "properties": {
        "maxMainStarts": { "const": 1 }, "maxConcurrent": { "const": 1 },
        "maxRetries": { "const": 0 }, "maxCorrections": { "const": 0 },
        "timeoutSeconds": { "type": "integer", "minimum": 2, "maximum": 120 },
        "terminationGraceSeconds": { "type": "integer", "minimum": 1, "maximum": 2 },
        "maxInputBytes": { "type": "integer", "minimum": 1, "maximum": 16384 },
        "maxStdoutBytes": { "type": "integer", "minimum": 1, "maximum": 262144 },
        "maxStderrBytes": { "type": "integer", "minimum": 1, "maximum": 32768 },
        "maxEventBytes": { "type": "integer", "minimum": 1, "maximum": 32768 },
        "maxEvents": { "type": "integer", "minimum": 1, "maximum": 512 }, "maxNativeTurns": { "const": 1 }
      }
    },
    "context": {
      "type": "object", "additionalProperties": false,
      "required": ["promptRef", "promptSha256", "inputBytes", "assessment"],
      "properties": {
        "promptRef": { "$ref": "#/$defs/id" }, "promptSha256": { "$ref": "#/$defs/sha" },
        "inputBytes": { "type": "integer", "minimum": 1, "maximum": 16384 }, "assessment": { "$ref": "#/$defs/assessment" }
      }
    },
    "effectId": { "enum": ["native-auth", "provider-inference", "client-state", "telemetry", "descendants"] },
    "effectIds": { "type": "array", "maxItems": 5, "uniqueItems": true, "items": { "$ref": "#/$defs/effectId" } },
    "authorization": {
      "type": "object", "additionalProperties": false,
      "required": ["status", "profile", "writer", "effectsApproved", "limits", "assessment"],
      "properties": {
        "status": { "enum": ["approved", "pending", "denied"] }, "profile": { "const": "supervised-subscription" },
        "writer": { "enum": ["user", "agent"] }, "effectsApproved": { "$ref": "#/$defs/effectIds" },
        "limits": { "$ref": "#/$defs/limits" }, "assessment": { "$ref": "#/$defs/assessment" }
      }
    },
    "limitations": {
      "type": "object", "additionalProperties": false,
      "required": ["internalCallsUnknownAccepted", "remoteCancellationUnknownAccepted", "assessment"],
      "properties": {
        "internalCallsUnknownAccepted": { "type": "boolean" }, "remoteCancellationUnknownAccepted": { "type": "boolean" },
        "assessment": { "$ref": "#/$defs/assessment" }
      }
    },
    "history": {
      "type": "object", "additionalProperties": false,
      "required": ["projectId", "taskId", "mainStartsUsed", "durationUsedSeconds", "actualModelCalls", "state", "assessment"],
      "properties": {
        "projectId": { "$ref": "#/$defs/id" }, "taskId": { "$ref": "#/$defs/id" },
        "mainStartsUsed": { "type": "integer", "minimum": 0, "maximum": 1000000 },
        "durationUsedSeconds": { "type": "integer", "minimum": 0, "maximum": 1000000 },
        "actualModelCalls": { "type": ["integer", "null"], "minimum": 0, "maximum": 1000000 },
        "state": { "enum": ["clear", "active", "reconciliation-required"] }, "assessment": { "$ref": "#/$defs/assessment" }
      }
    },
    "controlId": { "enum": ["no-tools", "no-subagents", "no-mcp", "no-hooks", "no-personalizations", "no-updates", "stdin-text", "no-fallback", "no-resume", "no-permission-bypass"] },
    "control": {
      "type": "object", "additionalProperties": false,
      "required": ["controlId", "mechanismId", "positiveEvidenceRef", "negativeEvidenceRef", "assessment"],
      "properties": {
        "controlId": { "$ref": "#/$defs/controlId" }, "mechanismId": { "$ref": "#/$defs/nullableId" },
        "positiveEvidenceRef": { "$ref": "#/$defs/nullableId" }, "negativeEvidenceRef": { "$ref": "#/$defs/nullableId" },
        "assessment": { "$ref": "#/$defs/assessment" }
      }
    },
    "effect": {
      "type": "object", "additionalProperties": false,
      "required": ["effectId", "presence", "disposition", "assessment"],
      "properties": {
        "effectId": { "$ref": "#/$defs/effectId" }, "presence": { "enum": ["present", "absent", "unknown"] },
        "disposition": { "enum": ["allowed", "rejected", "unknown"] }, "assessment": { "$ref": "#/$defs/assessment" }
      }
    },
    "installation": {
      "type": "object", "additionalProperties": false, "required": ["assessment"],
      "properties": { "assessment": { "$ref": "#/$defs/assessment" } }
    },
    "access": {
      "type": "object", "additionalProperties": false,
      "required": ["method", "externalBilling", "assessment", "billingAssessment"],
      "properties": {
        "method": { "enum": ["subscription-session", "api-key", "unknown"] },
        "externalBilling": { "enum": ["disabled", "enabled", "unknown"] },
        "assessment": { "$ref": "#/$defs/assessment" }, "billingAssessment": { "$ref": "#/$defs/assessment" }
      }
    },
    "observations": {
      "type": "array", "maxItems": 8, "uniqueItems": true,
      "items": { "enum": ["artifact-race-unresolved", "configuration-unresolved", "managed-policy-unresolved", "critical-effects-unresolved", "privacy-unresolved", "quota-exhausted", "termination-unconfirmed", "prior-consumption-unresolved"] }
    },
    "input": {
      "type": "object", "additionalProperties": false,
      "required": ["schemaVersion", "profile", "intentId", "now", "identity"],
      "properties": {
        "schemaVersion": { "const": "1.0.0" }, "profile": { "const": "supervised-subscription" },
        "intentId": { "$ref": "#/$defs/id" }, "now": { "$ref": "#/$defs/date" }, "identity": { "$ref": "#/$defs/identity" },
        "selection": { "$ref": "#/$defs/selection" }, "binding": { "$ref": "#/$defs/binding" },
        "expectedBinding": { "$ref": "#/$defs/binding" }, "limits": { "$ref": "#/$defs/limits" },
        "context": { "$ref": "#/$defs/context" }, "authorization": { "$ref": "#/$defs/authorization" },
        "limitations": { "$ref": "#/$defs/limitations" }, "history": { "$ref": "#/$defs/history" },
        "installation": { "$ref": "#/$defs/installation" },
        "controls": { "type": "array", "maxItems": 10, "items": { "$ref": "#/$defs/control" } },
        "effects": { "type": "array", "maxItems": 5, "items": { "$ref": "#/$defs/effect" } },
        "access": { "$ref": "#/$defs/access" }, "observations": { "$ref": "#/$defs/observations" }
      }
    },
    "policy": {
      "type": "object", "additionalProperties": false,
      "required": ["maxEvidenceAgeSeconds", "revokedEvidenceRefs", "limits"],
      "properties": {
        "maxEvidenceAgeSeconds": { "type": "integer", "minimum": 1, "maximum": 86400 },
        "revokedEvidenceRefs": { "type": "array", "maxItems": 256, "uniqueItems": true, "items": { "$ref": "#/$defs/id" } },
        "limits": { "$ref": "#/$defs/limits" }
      }
    },
    "codes": { "type": "array", "maxItems": 256, "uniqueItems": true, "items": { "type": "string", "pattern": "^[a-z][A-Za-z0-9.:-]{0,159}$" } },
    "nullableSha": { "anyOf": [{ "$ref": "#/$defs/sha" }, { "type": "null" }] },
    "report": {
      "type": "object", "additionalProperties": false,
      "required": ["schemaVersion", "profile", "intentId", "state", "executed", "runtimeReady", "verifiedAdmission", "externalBillingVerified", "selectionVerified", "internalCallCeiling", "remoteCancellationVerified", "reasons", "missing", "externalGates", "audit"],
      "properties": {
        "schemaVersion": { "const": "1.0.0" }, "profile": { "const": "supervised-subscription" },
        "intentId": { "$ref": "#/$defs/nullableId" }, "state": { "enum": ["invalid", "incomplete", "blocked", "ready-for-supervised-review"] },
        "executed": { "const": false }, "runtimeReady": { "const": false }, "verifiedAdmission": { "const": false },
        "externalBillingVerified": { "const": false }, "selectionVerified": { "const": false },
        "internalCallCeiling": { "type": "null" }, "remoteCancellationVerified": { "const": false },
        "reasons": { "$ref": "#/$defs/codes" }, "missing": { "$ref": "#/$defs/codes" },
        "externalGates": { "const": ["trusted-authorization-and-limitations", "native-installation-and-controls", "subscription-and-billing", "selection-and-private-context", "supervised-history-and-durable-reservation", "local-supervision-and-termination", "human-result-review"] },
        "audit": {
          "type": "object", "additionalProperties": false, "required": ["inputSha256", "scopeSha256", "policySha256"],
          "properties": { "inputSha256": { "$ref": "#/$defs/nullableSha" }, "scopeSha256": { "$ref": "#/$defs/nullableSha" }, "policySha256": { "$ref": "#/$defs/sha" } }
        }
      }
    }
  }
}
