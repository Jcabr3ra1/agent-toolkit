{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-toolkit.local/schemas/agent-client-managed-preferences-invocation.schema.json",
  "$defs": {
    "integer": { "type": "integer", "minimum": 0 },
    "pin": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "dev", "ino", "uid", "mode", "size", "mtimeMs", "ctimeMs", "sha256"],
      "properties": {
        "path": { "type": "string", "minLength": 1, "maxLength": 4096 },
        "dev": { "$ref": "#/$defs/integer" }, "ino": { "$ref": "#/$defs/integer" }, "uid": { "$ref": "#/$defs/integer" },
        "mode": { "type": "integer", "minimum": 0, "maximum": 4095 },
        "size": { "type": "integer", "minimum": 1, "maximum": 8388608 },
        "mtimeMs": { "type": "number", "minimum": 0 }, "ctimeMs": { "type": "number", "minimum": 0 },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    },
    "parent": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "dev", "ino", "uid", "mode"],
      "properties": {
        "path": { "type": "string", "minLength": 1, "maxLength": 4096 },
        "dev": { "$ref": "#/$defs/integer" }, "ino": { "$ref": "#/$defs/integer" }, "uid": { "$ref": "#/$defs/integer" },
        "mode": { "const": 448 }
      }
    },
    "limits": {
      "type": "object", "additionalProperties": false,
      "required": ["totalTimeoutMs", "graceMs", "confirmationMs", "maxOutputBytes", "maxErrorBytes", "permitLifetimeMs"],
      "properties": {
        "totalTimeoutMs": { "type": "integer", "minimum": 25, "maximum": 15000 },
        "graceMs": { "type": "integer", "minimum": 1, "maximum": 1000 },
        "confirmationMs": { "type": "integer", "minimum": 1, "maximum": 1000 },
        "maxOutputBytes": { "type": "integer", "minimum": 1, "maximum": 32768 },
        "maxErrorBytes": { "type": "integer", "minimum": 1, "maximum": 32768 },
        "permitLifetimeMs": { "type": "integer", "minimum": 1, "maximum": 3600000 }
      }
    },
    "configuration": {
      "type": "object", "additionalProperties": false,
      "required": ["expectedSource", "artifact", "workspaceParent", "limits"],
      "properties": {
        "expectedSource": { "enum": ["synthetic", "core-foundation-claim"] },
        "artifact": { "$ref": "#/$defs/pin" }, "workspaceParent": { "$ref": "#/$defs/parent" }, "limits": { "$ref": "#/$defs/limits" }
      }
    },
    "report": {
      "type": "object", "additionalProperties": false,
      "required": ["scope", "state", "decision", "spawnAttempts", "helperStarted", "helperExecutionVerified", "artifactMatchedBefore", "artifactMatchedAfter", "terminationConfirmed", "cleanupRequired", "stdoutBytes", "stderrBytes", "elapsedMs", "projection", "reasons", "nativeClientStarted", "inferenceRequested", "runtimeReady", "verifiedAdmission", "effectiveIsolationVerified", "externalBillingVerified", "preferencesQueriedVerified"],
      "properties": {
        "scope": { "const": "managed-preferences-helper-only" },
        "state": { "enum": ["blocked", "completed", "helper-failed", "failed", "canceled", "timed-out", "indeterminate"] },
        "decision": { "const": "no-client-start" },
        "spawnAttempts": { "type": "integer", "minimum": 0, "maximum": 1 },
        "helperStarted": { "type": "boolean" }, "helperExecutionVerified": { "type": "boolean" },
        "artifactMatchedBefore": { "type": "boolean" }, "artifactMatchedAfter": { "type": "boolean" },
        "terminationConfirmed": { "type": "boolean" }, "cleanupRequired": { "type": "boolean" },
        "stdoutBytes": { "$ref": "#/$defs/integer" }, "stderrBytes": { "$ref": "#/$defs/integer" }, "elapsedMs": { "$ref": "#/$defs/integer" },
        "projection": { "anyOf": [{ "type": "null" }, { "$ref": "agent-client-managed-preferences.schema.json#/$defs/report" }] },
        "reasons": { "type": "array", "minItems": 1, "maxItems": 32, "uniqueItems": true, "items": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$" } },
        "nativeClientStarted": { "const": false }, "inferenceRequested": { "const": false }, "runtimeReady": { "const": false },
        "verifiedAdmission": { "const": false }, "effectiveIsolationVerified": { "const": false }, "externalBillingVerified": { "const": false },
        "preferencesQueriedVerified": { "const": false }
      }
    }
  }
}
