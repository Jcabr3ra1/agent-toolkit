{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-toolkit.local/schemas/agent-client-native-evaluation.schema.json",
  "title": "C3.1a Offline Native Evidence",
  "description": "Declaraciones sintéticas; no certifica instalaciones ni autoriza ejecución.",
  "$ref": "#/$defs/input",
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$" },
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "timestamp": { "type": "string", "format": "date-time" },
    "nullableId": { "anyOf": [{ "$ref": "#/$defs/id" }, { "type": "null" }] },
    "client": {
      "type": "object", "additionalProperties": false,
      "required": ["provider", "client", "variant", "clientVersion"],
      "properties": {
        "provider": { "enum": ["openai", "anthropic"] },
        "client": { "enum": ["codex-cli", "claude-code"] },
        "variant": { "enum": ["codex-native", "claude-native"] },
        "clientVersion": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[a-z0-9.-]+)?$", "maxLength": 64 }
      },
      "oneOf": [
        { "properties": { "provider": { "const": "openai" }, "client": { "const": "codex-cli" }, "variant": { "const": "codex-native" } } },
        { "properties": { "provider": { "const": "anthropic" }, "client": { "const": "claude-code" }, "variant": { "const": "claude-native" } } }
      ]
    },
    "binding": {
      "type": "object", "additionalProperties": false,
      "required": ["client", "platform", "architecture", "installationId", "artifactSha256", "configSha256", "environmentSha256", "controlRevision"],
      "properties": {
        "client": { "$ref": "#/$defs/client" },
        "platform": { "enum": ["darwin", "linux", "win32"] },
        "architecture": { "enum": ["arm64", "x64"] },
        "installationId": { "$ref": "#/$defs/id" },
        "artifactSha256": { "$ref": "#/$defs/sha256" },
        "configSha256": { "$ref": "#/$defs/sha256" },
        "environmentSha256": { "$ref": "#/$defs/sha256" },
        "controlRevision": { "$ref": "#/$defs/id" }
      }
    },
    "assessment": {
      "type": "object", "additionalProperties": false,
      "required": ["status", "source", "checkedAt", "expiresAt", "evidenceRef", "scopeSha256"],
      "properties": {
        "status": { "enum": ["documented", "locally-tested", "pending", "rejected"] },
        "source": { "enum": ["provider-documentation", "installation-test", "operator-attestation"] },
        "checkedAt": { "$ref": "#/$defs/timestamp" },
        "expiresAt": { "$ref": "#/$defs/timestamp" },
        "evidenceRef": { "$ref": "#/$defs/id" },
        "scopeSha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "artifact": {
      "type": "object", "additionalProperties": false,
      "required": ["artifactId", "kind", "sha256"],
      "properties": {
        "artifactId": { "$ref": "#/$defs/id" },
        "kind": { "enum": ["binary", "wrapper", "interpreter", "package"] },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "installation": {
      "type": "object", "additionalProperties": false, "required": ["assessment", "artifacts"],
      "properties": {
        "assessment": { "$ref": "#/$defs/assessment" },
        "artifacts": { "type": "array", "minItems": 1, "maxItems": 32, "items": { "$ref": "#/$defs/artifact" } }
      }
    },
    "controlId": {
      "enum": ["no-tools", "no-subagents", "no-mcp", "no-hooks", "no-personalizations", "no-updates", "stdin-text", "no-fallback", "no-resume", "no-permission-bypass", "internal-call-limit"]
    },
    "control": {
      "type": "object", "additionalProperties": false,
      "required": ["controlId", "assessment", "mechanismId", "positiveEvidenceRef", "negativeEvidenceRef"],
      "properties": {
        "controlId": { "$ref": "#/$defs/controlId" },
        "assessment": { "$ref": "#/$defs/assessment" },
        "mechanismId": { "$ref": "#/$defs/nullableId" },
        "positiveEvidenceRef": { "$ref": "#/$defs/nullableId" },
        "negativeEvidenceRef": { "$ref": "#/$defs/nullableId" }
      }
    },
    "effectId": { "enum": ["native-auth", "provider-inference", "client-state", "telemetry", "descendants"] },
    "authorization": {
      "type": "object", "additionalProperties": false,
      "required": ["status", "evidenceRef", "scopeSha256"],
      "properties": {
        "status": { "enum": ["approved", "pending", "denied"] },
        "evidenceRef": { "$ref": "#/$defs/nullableId" },
        "scopeSha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "effect": {
      "type": "object", "additionalProperties": false,
      "required": ["effectId", "disposition", "presence", "assessment", "authorization"],
      "properties": {
        "effectId": { "$ref": "#/$defs/effectId" },
        "disposition": { "enum": ["allowed", "rejected", "unknown"] },
        "presence": { "enum": ["present", "absent", "unknown"] },
        "assessment": { "$ref": "#/$defs/assessment" },
        "authorization": { "$ref": "#/$defs/authorization" }
      }
    },
    "access": {
      "type": "object", "additionalProperties": false,
      "required": ["access", "externalBilling", "assessment", "billingAssessment"],
      "properties": {
        "access": { "enum": ["subscription-session", "api-key", "unknown"] },
        "externalBilling": { "enum": ["disabled", "enabled", "unknown"] },
        "assessment": { "$ref": "#/$defs/assessment" },
        "billingAssessment": { "$ref": "#/$defs/assessment" }
      }
    },
    "accounting": {
      "type": "object", "additionalProperties": false,
      "required": ["maxCallsPerStart", "limitEnforced", "assessment"],
      "properties": {
        "maxCallsPerStart": { "type": ["integer", "null"], "minimum": 1, "maximum": 1000000 },
        "limitEnforced": { "type": "boolean" },
        "assessment": { "$ref": "#/$defs/assessment" }
      }
    },
    "input": {
      "type": "object", "additionalProperties": false,
      "required": ["schemaVersion", "evaluationId", "now", "expectedBinding", "binding"],
      "properties": {
        "schemaVersion": { "const": "1.0.0" },
        "evaluationId": { "$ref": "#/$defs/id" },
        "now": { "$ref": "#/$defs/timestamp" },
        "expectedBinding": { "$ref": "#/$defs/binding" },
        "binding": { "$ref": "#/$defs/binding" },
        "installation": { "$ref": "#/$defs/installation" },
        "controls": { "type": "array", "maxItems": 11, "items": { "$ref": "#/$defs/control" } },
        "effects": { "type": "array", "maxItems": 5, "items": { "$ref": "#/$defs/effect" } },
        "access": { "$ref": "#/$defs/access" },
        "accounting": { "$ref": "#/$defs/accounting" },
        "observations": {
          "type": "array", "maxItems": 7, "uniqueItems": true,
          "items": { "enum": ["artifact-race-unresolved", "effective-config-unknown", "managed-policy-unknown", "native-effects-unknown", "subscription-compatibility-unknown", "internal-calls-unknown", "descendant-containment-unknown"] }
        }
      }
    },
    "policy": {
      "type": "object", "additionalProperties": false,
      "required": ["maxEvidenceAgeSeconds", "revokedEvidenceRefs"],
      "properties": {
        "maxEvidenceAgeSeconds": { "type": "integer", "minimum": 1, "maximum": 86400 },
        "revokedEvidenceRefs": { "type": "array", "maxItems": 256, "uniqueItems": true, "items": { "$ref": "#/$defs/id" } }
      }
    },
    "report": {
      "type": "object", "additionalProperties": false,
      "required": ["schemaVersion", "state", "evaluationId", "executed", "runtimeReady", "verifiedAdmission", "reasons", "missing", "audit"],
      "properties": {
        "schemaVersion": { "const": "1.0.0" },
        "state": { "enum": ["invalid", "incomplete", "blocked", "ready-for-installation-review"] },
        "evaluationId": { "$ref": "#/$defs/nullableId" },
        "executed": { "const": false }, "runtimeReady": { "const": false }, "verifiedAdmission": { "const": false },
        "reasons": { "type": "array", "maxItems": 256, "uniqueItems": true, "items": { "type": "string", "pattern": "^[a-z0-9:.-]{1,160}$" } },
        "missing": { "type": "array", "maxItems": 256, "uniqueItems": true, "items": { "type": "string", "pattern": "^[a-z0-9.-]{1,160}$" } },
        "audit": {
          "type": "object", "additionalProperties": false, "required": ["inputSha256", "bindingSha256", "policySha256"],
          "properties": {
            "inputSha256": { "anyOf": [{ "$ref": "#/$defs/sha256" }, { "type": "null" }] },
            "bindingSha256": { "anyOf": [{ "$ref": "#/$defs/sha256" }, { "type": "null" }] },
            "policySha256": { "$ref": "#/$defs/sha256" }
          }
        }
      }
    }
  }
}
