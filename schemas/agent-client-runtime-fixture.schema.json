{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-toolkit.local/schemas/agent-client-runtime-fixture.schema.json",
  "title": "C2.2 trusted fixture-only supervision, no native client",
  "$ref": "#/$defs/request",
  "$defs": {
    "id": { "$ref": "https://agent-toolkit.local/schemas/agent-client-adapter.schema.json#/$defs/id" },
    "limits": {
      "type": "object", "additionalProperties": false,
      "required": ["timeoutMs", "graceMs", "confirmationMs", "maxInputBytes", "maxOutputBytes", "maxLineBytes", "maxEvents", "maxStderrBytes"],
      "properties": {
        "timeoutMs": { "type": "integer", "minimum": 600, "maximum": 10000 },
        "graceMs": { "type": "integer", "minimum": 50, "maximum": 1000 },
        "confirmationMs": { "type": "integer", "minimum": 100, "maximum": 2000 },
        "maxInputBytes": { "type": "integer", "minimum": 1, "maximum": 1048576 },
        "maxOutputBytes": { "type": "integer", "minimum": 1, "maximum": 1048576 },
        "maxLineBytes": { "type": "integer", "minimum": 1, "maximum": 16384 },
        "maxEvents": { "type": "integer", "minimum": 2, "maximum": 256 },
        "maxStderrBytes": { "type": "integer", "minimum": 0, "maximum": 16384 }
      }
    },
    "authorization": {
      "type": "object", "additionalProperties": false,
      "required": ["status", "revoked", "referenceId", "evidenceRef", "checkedAt", "expiresAt", "fixtureId", "attemptId", "identity", "rootSha256", "limitsSha256", "reconciliationApproved"],
      "properties": {
        "status": { "enum": ["approved", "pending", "denied"] }, "revoked": { "type": "boolean" },
        "referenceId": { "$ref": "#/$defs/id" }, "evidenceRef": { "$ref": "#/$defs/id" },
        "checkedAt": { "type": "string", "format": "date-time" }, "expiresAt": { "type": "string", "format": "date-time" },
        "fixtureId": { "$ref": "#/$defs/id" }, "attemptId": { "$ref": "#/$defs/id" },
        "identity": { "$ref": "https://agent-toolkit.local/schemas/agent-client-runtime-local.schema.json#/$defs/identity" },
        "rootSha256": { "$ref": "https://agent-toolkit.local/schemas/agent-client-runtime-local.schema.json#/$defs/sha256" },
        "limitsSha256": { "$ref": "https://agent-toolkit.local/schemas/agent-client-runtime-local.schema.json#/$defs/sha256" },
        "reconciliationApproved": { "type": "boolean" }
      }
    },
    "request": {
      "type": "object", "additionalProperties": false,
      "required": ["schemaVersion", "scope", "fixtureId", "inputText", "limits", "reservation", "authorization"],
      "properties": {
        "schemaVersion": { "const": "1.0.0" }, "scope": { "const": "fixture-only" },
        "fixtureId": { "enum": ["success", "split-utf8", "silent", "blocked-stdin", "failure", "stdout-overflow", "stderr-overflow", "long-line", "event-overflow", "invalid-utf8", "forbidden-event", "duplicate-json", "after-terminal", "unterminated", "incomplete", "ignore-term", "parent-child", "child-after-parent", "stderr-invalid", "environment", "closed-stdin"] },
        "inputText": { "type": "string", "maxLength": 1048576 }, "limits": { "$ref": "#/$defs/limits" },
        "reservation": { "$ref": "https://agent-toolkit.local/schemas/agent-client-runtime-local.schema.json#/$defs/request" },
        "authorization": { "$ref": "#/$defs/authorization" }
      }
    },
    "processReport": {
      "type": "object", "additionalProperties": false,
      "required": ["scope", "state", "fixtureExecuted", "spawnAttempts", "nativeExecuted", "runtimeReady", "verifiedAdmission", "modelCalls", "started", "exitObserved", "pipesClosed", "groupObservation", "terminationConfirmed", "stdoutBytes", "stderrBytes", "events", "elapsedMs", "reasons"],
      "properties": {
        "scope": { "const": "fixture-only" }, "state": { "enum": ["not-started", "completed", "failed", "canceled", "timed-out", "indeterminate"] },
        "fixtureExecuted": { "type": "boolean" }, "spawnAttempts": { "type": "integer", "minimum": 0, "maximum": 1 },
        "nativeExecuted": { "const": false }, "runtimeReady": { "const": false }, "verifiedAdmission": { "const": false }, "modelCalls": { "const": 0 },
        "started": { "type": "boolean" }, "exitObserved": { "type": "boolean" }, "pipesClosed": { "type": "boolean" },
        "groupObservation": { "enum": ["not-started", "absent", "unconfirmed"] }, "terminationConfirmed": { "type": "boolean" },
        "stdoutBytes": { "type": "integer", "minimum": 0 }, "stderrBytes": { "type": "integer", "minimum": 0 }, "events": { "type": "integer", "minimum": 0 },
        "elapsedMs": { "type": "integer", "minimum": 0 }, "reasons": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/id" } }
      },
      "allOf": [
        { "if": { "properties": { "state": { "const": "completed" } } }, "then": { "properties": { "fixtureExecuted": { "const": true }, "started": { "const": true }, "exitObserved": { "const": true }, "pipesClosed": { "const": true }, "terminationConfirmed": { "const": true }, "groupObservation": { "const": "absent" } } } },
        { "if": { "properties": { "state": { "const": "not-started" } } }, "then": { "properties": { "fixtureExecuted": { "const": false }, "started": { "const": false } } } }
      ]
    },
    "report": {
      "type": "object", "additionalProperties": false,
      "required": ["schemaVersion", "scope", "state", "identity", "attemptId", "fixtureExecuted", "nativeExecuted", "runtimeReady", "verifiedAdmission", "modelCalls", "process", "storage", "reasons"],
      "properties": {
        "schemaVersion": { "const": "1.0.0" }, "scope": { "const": "fixture-only" },
        "state": { "enum": ["not-started", "completed", "failed", "canceled", "timed-out", "indeterminate"] },
        "identity": { "anyOf": [{ "$ref": "https://agent-toolkit.local/schemas/agent-client-runtime-local.schema.json#/$defs/identity" }, { "type": "null" }] },
        "attemptId": { "anyOf": [{ "$ref": "#/$defs/id" }, { "type": "null" }] },
        "fixtureExecuted": { "type": "boolean" }, "nativeExecuted": { "const": false }, "runtimeReady": { "const": false }, "verifiedAdmission": { "const": false }, "modelCalls": { "const": 0 },
        "process": { "anyOf": [{ "$ref": "#/$defs/processReport" }, { "type": "null" }] },
        "storage": { "anyOf": [{ "type": "null" }, {
          "type": "object", "additionalProperties": false, "required": ["state", "writeObservation", "durability", "cleanup", "revision", "reasons"],
          "properties": {
            "state": { "enum": ["committed", "unchanged", "blocked", "indeterminate"] },
            "writeObservation": { "enum": ["unchanged", "replaced", "unknown"] }, "durability": { "enum": ["confirmed", "unconfirmed"] }, "cleanup": { "enum": ["complete", "intervention-required"] },
            "revision": { "anyOf": [{ "type": "integer", "minimum": 0, "maximum": 1000000 }, { "type": "null" }] },
            "reasons": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/id" } }
          }
        }] },
        "reasons": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/id" } }
      },
      "allOf": [
        { "if": { "properties": { "state": { "const": "completed" } } }, "then": { "properties": { "fixtureExecuted": { "const": true }, "process": { "type": "object", "properties": { "state": { "const": "completed" } } }, "storage": { "type": "object", "properties": { "state": { "const": "committed" }, "cleanup": { "const": "complete" }, "durability": { "const": "confirmed" } } } } } }
      ]
    }
  }
}
