{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-toolkit.local/schemas/agent-client-selective-config.schema.json",
  "$defs": {
    "limits": {
      "type": "object", "additionalProperties": false,
      "required": ["maxBytes", "blockBytes", "maxDepth", "maxNodes", "maxKeyBytes", "maxKeys"],
      "properties": {
        "maxBytes": {"type": "integer", "minimum": 1, "maximum": 1048576},
        "blockBytes": {"type": "integer", "minimum": 1, "maximum": 4096},
        "maxDepth": {"type": "integer", "minimum": 1, "maximum": 32},
        "maxNodes": {"type": "integer", "minimum": 1, "maximum": 20000},
        "maxKeyBytes": {"type": "integer", "minimum": 1, "maximum": 256},
        "maxKeys": {"type": "integer", "minimum": 1, "maximum": 4096}
      }
    },
    "field": {
      "type": "object", "additionalProperties": false,
      "required": ["name", "present", "type", "empty", "booleanValue"],
      "properties": {
        "name": {"enum": ["hooks", "apiKeyHelper", "disableAllHooks", "mcpServers"]},
        "present": {"type": "boolean"},
        "type": {"enum": ["object", "array", "string", "number", "boolean", "null", null]},
        "empty": {"type": ["boolean", "null"]}, "booleanValue": {"type": ["boolean", "null"]}
      }
    },
    "sourceObservation": {
      "type": "object", "additionalProperties": false,
      "required": ["sourceId", "state", "provenance", "fields", "projectionSha256", "stats"],
      "properties": {
        "sourceId": {"enum": ["personal-settings", "global-state"]}, "state": {"enum": ["observed", "incomplete", "blocked"]},
        "provenance": {"enum": ["local-structure-observation", "pending"]},
        "fields": {"type": "array", "maxItems": 3, "items": {"$ref": "#/$defs/field"}},
        "projectionSha256": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"},
        "stats": {"anyOf": [{"$ref": "#/$defs/report/properties/stats"}, {"type": "null"}]}
      }
    },
    "fileReport": {
      "type": "object", "additionalProperties": false,
      "required": ["scope", "state", "sources", "inferenceRequested", "nativeExecuted", "runtimeReady", "verifiedAdmission", "externalBillingVerified", "effectiveControlsVerified", "bytesRead", "elapsedMs", "reasons"],
      "properties": {
        "scope": {"const": "selective-local-structure-only"}, "state": {"enum": ["observed", "incomplete", "blocked"]},
        "sources": {"type": "array", "maxItems": 2, "items": {"$ref": "#/$defs/sourceObservation"}},
        "inferenceRequested": {"const": false}, "nativeExecuted": {"const": false}, "runtimeReady": {"const": false},
        "verifiedAdmission": {"const": false}, "externalBillingVerified": {"const": false}, "effectiveControlsVerified": {"const": false},
        "bytesRead": {"type": "integer", "minimum": 0, "maximum": 2097152},
        "elapsedMs": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
        "reasons": {"type": "array", "maxItems": 1, "items": {"enum": ["selective-local-observed", "selective-clock-unavailable", "selective-permit-unavailable", "selective-input-forbidden", "selective-owner-unavailable", "selective-path-unsafe", "selective-file-unsafe", "selective-file-limit", "selective-file-changed", "selective-read-limit", "selective-canceled", "selective-deadline", "selective-source-missing", "selective-file-unconfirmed", "selective-byte-limit", "selective-block-invalid", "selective-depth-limit", "selective-node-limit", "selective-key-limit", "selective-key-bytes-limit", "selective-duplicate-key", "selective-invalid-utf8", "selective-invalid-unicode", "selective-invalid-json", "selective-root-object-required", "selective-truncated", "selective-closed"]}}
      }
    },
    "report": {
      "type": "object", "additionalProperties": false,
      "required": ["scope", "sourceId", "state", "provenance", "fields", "projectionSha256", "inferenceRequested", "nativeExecuted", "runtimeReady", "verifiedAdmission", "externalBillingVerified", "effectiveControlsVerified", "stats", "reasons"],
      "properties": {
        "scope": {"const": "selective-local-structure-only"}, "sourceId": {"enum": ["personal-settings", "global-state"]},
        "state": {"enum": ["invalid", "incomplete", "observed", "blocked"]}, "provenance": {"const": "provided-bytes-structure"},
        "fields": {"type": "array", "maxItems": 3, "items": {"$ref": "#/$defs/field"}},
        "projectionSha256": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"},
        "inferenceRequested": {"const": false}, "nativeExecuted": {"const": false}, "runtimeReady": {"const": false},
        "verifiedAdmission": {"const": false}, "externalBillingVerified": {"const": false}, "effectiveControlsVerified": {"const": false},
        "stats": {
          "type": "object", "additionalProperties": false,
          "required": ["bytes", "nodes", "keys", "peakDepth", "peakKeyDigests", "retainedRawBytes", "retainedValueTextBytes"],
          "properties": {
            "bytes": {"type": "integer", "minimum": 0, "maximum": 1052672},
            "nodes": {"type": "integer", "minimum": 0, "maximum": 20001},
            "keys": {"type": "integer", "minimum": 0, "maximum": 4097},
            "peakDepth": {"type": "integer", "minimum": 0, "maximum": 33},
            "peakKeyDigests": {"type": "integer", "minimum": 0, "maximum": 4096},
            "retainedRawBytes": {"const": 0}, "retainedValueTextBytes": {"const": 0}
          }
        },
        "reasons": {"type": "array", "maxItems": 1, "items": {"enum": ["selective-observed", "selective-incomplete", "selective-byte-limit", "selective-block-invalid", "selective-depth-limit", "selective-node-limit", "selective-key-limit", "selective-key-bytes-limit", "selective-duplicate-key", "selective-invalid-utf8", "selective-invalid-unicode", "selective-invalid-json", "selective-root-object-required", "selective-truncated", "selective-closed"]}}
      }
    }
  }
}
