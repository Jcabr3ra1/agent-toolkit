{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-toolkit.local/schemas/agent-client-managed-preferences.schema.json",
  "$ref": "#/$defs/wire",
  "$defs": {
    "source": { "enum": ["synthetic", "core-foundation-claim"] },
    "field": {
      "type": "object", "additionalProperties": false,
      "required": ["name", "type", "forced"],
      "properties": {
        "name": { "enum": ["hooks", "policyHelper", "apiKeyHelper", "env", "managedMcpServers", "disableAllHooks"] },
        "type": { "enum": ["not-found-by-api", "boolean", "number", "string", "array", "dictionary", "other"] },
        "forced": { "enum": ["forced", "not-forced", "unknown"] }
      }
    },
    "wire": {
      "oneOf": [
        {
          "type": "object", "additionalProperties": false,
          "required": ["schemaVersion", "source", "application", "status", "fields"],
          "properties": {
            "schemaVersion": { "const": "1.0.0" },
            "source": { "$ref": "#/$defs/source" },
            "application": { "const": "com.anthropic.claudecode" },
            "status": { "const": "complete" },
            "fields": { "type": "array", "minItems": 6, "maxItems": 6, "items": { "$ref": "#/$defs/field" } }
          }
        },
        {
          "type": "object", "additionalProperties": false,
          "required": ["schemaVersion", "source", "status", "code"],
          "properties": {
            "schemaVersion": { "const": "1.0.0" },
            "source": { "$ref": "#/$defs/source" },
            "status": { "const": "failed" },
            "code": { "enum": ["preferences-arguments-rejected", "preferences-backend-failed", "preferences-type-rejected"] }
          }
        }
      ]
    },
    "report": {
      "type": "object", "additionalProperties": false,
      "required": ["scope", "state", "decision", "sourceClaim", "fields", "reasons", "helperExecutionVerified", "preferencesQueriedVerified", "runtimeReady", "verifiedAdmission", "effectiveIsolationVerified", "externalBillingVerified"],
      "properties": {
        "scope": { "const": "partial-preference-observation" },
        "state": { "enum": ["invalid", "helper-failed", "partial-observation"] },
        "decision": { "const": "no-native-start" },
        "sourceClaim": { "anyOf": [{ "type": "null" }, { "$ref": "#/$defs/source" }] },
        "fields": { "type": "array", "maxItems": 6, "items": { "$ref": "#/$defs/field" } },
        "reasons": {
          "type": "array", "minItems": 1, "maxItems": 8, "uniqueItems": true,
          "items": { "enum": ["preferences-invalid-output", "preferences-source-mismatch", "preferences-exit-mismatch", "preferences-observation-partial", "preferences-force-unknown", "preferences-nonatomic-observation", "preferences-arguments-rejected", "preferences-backend-failed", "preferences-type-rejected", "preferences-stream-closed", "preferences-transport-timeout", "preferences-transport-overflow", "preferences-transport-unconfirmed", "preferences-transport-changed-artifact", "preferences-transport-error"] }
        },
        "helperExecutionVerified": { "const": false },
        "preferencesQueriedVerified": { "const": false },
        "runtimeReady": { "const": false },
        "verifiedAdmission": { "const": false },
        "effectiveIsolationVerified": { "const": false },
        "externalBillingVerified": { "const": false }
      }
    }
  }
}
