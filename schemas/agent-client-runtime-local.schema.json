{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-toolkit.local/schemas/agent-client-runtime-local.schema.json",
  "title": "C2.1 cooperative local store, not execution permission",
  "$ref": "#/$defs/request",
  "$defs": {
    "id": { "$ref": "https://agent-toolkit.local/schemas/agent-client-adapter.schema.json#/$defs/id" },
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "identity": {
      "type": "object", "additionalProperties": false, "required": ["projectId", "taskId"],
      "properties": { "projectId": { "$ref": "#/$defs/id" }, "taskId": { "$ref": "#/$defs/id" } }
    },
    "configuration": {
      "type": "object", "additionalProperties": false,
      "required": ["root", "forbiddenRoots", "evaluation"],
      "properties": {
        "root": { "type": "string", "minLength": 2, "maxLength": 4096 },
        "forbiddenRoots": { "type": "array", "minItems": 1, "maxItems": 64, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 4096 } },
        "evaluation": {
          "type": "object", "additionalProperties": false,
          "required": ["platform", "nodeVersion", "filesystem", "synchronized", "evidenceRef"],
          "properties": {
            "platform": { "enum": ["darwin", "linux"] }, "nodeVersion": { "type": "string", "pattern": "^v[0-9]+\\.[0-9]+\\.[0-9]+$" },
            "filesystem": { "const": "local" }, "synchronized": { "const": false }, "evidenceRef": { "$ref": "#/$defs/id" }
          }
        }
      }
    },
    "authorization": {
      "type": "object", "additionalProperties": false,
      "required": ["status", "revoked", "referenceId", "source", "checkedAt", "expiresAt", "evidenceRef", "identity", "rootSha256", "operations"],
      "properties": {
        "status": { "enum": ["approved", "pending", "denied"] }, "revoked": { "type": "boolean" },
        "referenceId": { "$ref": "#/$defs/id" }, "source": { "const": "operator-attestation" },
        "checkedAt": { "type": "string", "format": "date-time" }, "expiresAt": { "type": "string", "format": "date-time" },
        "evidenceRef": { "$ref": "#/$defs/id" }, "identity": { "$ref": "#/$defs/identity" }, "rootSha256": { "$ref": "#/$defs/sha256" },
        "operations": { "type": "array", "maxItems": 3, "uniqueItems": true, "items": { "enum": ["initialize", "read", "apply"] } }
      }
    },
    "request": {
      "oneOf": [
        {
          "type": "object", "additionalProperties": false, "required": ["schemaVersion", "operation", "identity", "authorization", "ledger", "importReferenceId"],
          "properties": {
            "schemaVersion": { "const": "1.0.0" }, "operation": { "const": "initialize" }, "identity": { "$ref": "#/$defs/identity" },
            "authorization": { "$ref": "#/$defs/authorization" }, "ledger": { "$ref": "https://agent-toolkit.local/schemas/agent-client-runtime.schema.json#/$defs/ledger" },
            "importReferenceId": { "$ref": "#/$defs/id" }
          }
        },
        {
          "type": "object", "additionalProperties": false, "required": ["schemaVersion", "operation", "identity", "authorization"],
          "properties": {
            "schemaVersion": { "const": "1.0.0" }, "operation": { "const": "read" }, "identity": { "$ref": "#/$defs/identity" }, "authorization": { "$ref": "#/$defs/authorization" }
          }
        },
        {
          "type": "object", "additionalProperties": false, "required": ["schemaVersion", "operation", "identity", "authorization", "transition"],
          "properties": {
            "schemaVersion": { "const": "1.0.0" }, "operation": { "const": "apply" }, "identity": { "$ref": "#/$defs/identity" },
            "authorization": { "$ref": "#/$defs/authorization" }, "transition": { "$ref": "https://agent-toolkit.local/schemas/agent-client-runtime.schema.json#/$defs/stateInput" }
          }
        }
      ]
    },
    "document": {
      "type": "object", "additionalProperties": false, "required": ["storageVersion", "identity", "ledgerSha256", "ledger"],
      "properties": {
        "storageVersion": { "const": "1.0.0" }, "identity": { "$ref": "#/$defs/identity" }, "ledgerSha256": { "$ref": "#/$defs/sha256" },
        "ledger": { "$ref": "https://agent-toolkit.local/schemas/agent-client-runtime.schema.json#/$defs/ledger" }
      }
    },
    "report": {
      "type": "object", "additionalProperties": false,
      "required": ["schemaVersion", "engineVersion", "scope", "state", "executed", "nativeExecuted", "runtimeReady", "verifiedAdmission", "writeObservation", "durability", "cleanup", "identity", "snapshot", "snapshotSha256", "reasons"],
      "properties": {
        "schemaVersion": { "const": "1.0.0" }, "engineVersion": { "const": "1.0.0" }, "scope": { "const": "cooperative-local-data-only" },
        "state": { "enum": ["committed", "unchanged", "blocked", "indeterminate"] },
        "executed": { "const": false }, "nativeExecuted": { "const": false }, "runtimeReady": { "const": false }, "verifiedAdmission": { "const": false },
        "writeObservation": { "enum": ["unchanged", "replaced", "unknown"] }, "durability": { "enum": ["confirmed", "unconfirmed"] },
        "cleanup": { "enum": ["complete", "intervention-required"] },
        "identity": { "anyOf": [{ "$ref": "#/$defs/identity" }, { "type": "null" }] },
        "snapshot": { "anyOf": [{ "$ref": "https://agent-toolkit.local/schemas/agent-client-runtime.schema.json#/$defs/ledger" }, { "type": "null" }] },
        "snapshotSha256": { "anyOf": [{ "$ref": "#/$defs/sha256" }, { "type": "null" }] },
        "reasons": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/id" } }
      },
      "allOf": [
        { "if": { "properties": { "state": { "const": "committed" } } }, "then": { "properties": { "writeObservation": { "const": "replaced" }, "durability": { "const": "confirmed" }, "cleanup": { "const": "complete" }, "identity": { "type": "object" }, "snapshot": { "type": "object" }, "snapshotSha256": { "type": "string" } } } },
        { "if": { "properties": { "state": { "const": "unchanged" } } }, "then": { "properties": { "writeObservation": { "const": "unchanged" }, "durability": { "const": "unconfirmed" }, "cleanup": { "const": "complete" }, "identity": { "type": "object" }, "snapshot": { "type": "object" }, "snapshotSha256": { "type": "string" } } } },
        { "if": { "properties": { "state": { "const": "blocked" } } }, "then": { "properties": { "writeObservation": { "const": "unchanged" }, "durability": { "const": "unconfirmed" }, "cleanup": { "const": "complete" } } } },
        { "if": { "properties": { "state": { "const": "indeterminate" } } }, "then": { "properties": { "cleanup": { "const": "intervention-required" } } } },
        { "if": { "properties": { "state": { "enum": ["blocked", "indeterminate"] } } }, "then": { "properties": { "snapshot": { "type": "null" }, "snapshotSha256": { "type": "null" } } } }
      ]
    }
  }
}
