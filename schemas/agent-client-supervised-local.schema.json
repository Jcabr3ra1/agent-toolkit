{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-toolkit.local/schemas/agent-client-supervised-local.schema.json",
  "title": "S2 independent supervised fixture-only local contract",
  "$defs": {
    "id": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$"},
    "sha": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "identity": {
      "type": "object", "additionalProperties": false,
      "required": ["projectId", "taskId", "taskRevision"],
      "properties": {
        "projectId": {"$ref": "#/$defs/id"}, "taskId": {"$ref": "#/$defs/id"},
        "taskRevision": {"$ref": "#/$defs/id"}
      }
    },
    "limits": {
      "type": "object", "additionalProperties": false,
      "required": ["maxMainStarts", "concurrency", "retries", "corrections", "timeoutMs", "graceMs", "confirmationMs", "maxInputBytes", "maxOutputBytes", "maxStderrBytes", "maxLineBytes", "maxEvents"],
      "properties": {
        "maxMainStarts": {"const": 1}, "concurrency": {"const": 1},
        "retries": {"const": 0}, "corrections": {"const": 0},
        "timeoutMs": {"type": "integer", "minimum": 100, "maximum": 120000},
        "graceMs": {"type": "integer", "minimum": 10, "maximum": 2000},
        "confirmationMs": {"type": "integer", "minimum": 10, "maximum": 2000},
        "maxInputBytes": {"type": "integer", "minimum": 1, "maximum": 16384},
        "maxOutputBytes": {"type": "integer", "minimum": 1, "maximum": 262144},
        "maxStderrBytes": {"type": "integer", "minimum": 1, "maximum": 32768},
        "maxLineBytes": {"type": "integer", "minimum": 1, "maximum": 32768},
        "maxEvents": {"type": "integer", "minimum": 1, "maximum": 512}
      }
    },
    "fixtureId": {"enum": ["success", "split-utf8", "environment", "silent", "blocked-stdin", "closed-stdin", "failure", "stdout-overflow", "stderr-overflow", "stderr-invalid", "long-line", "event-overflow", "invalid-utf8", "forbidden-event", "duplicate-json", "after-terminal", "unterminated", "incomplete", "ignore-term", "parent-child", "child-after-parent"]},
    "request": {
      "type": "object", "additionalProperties": false,
      "required": ["schemaVersion", "scope", "identity", "attemptId", "fixtureId", "inputText", "limits"],
      "properties": {
        "schemaVersion": {"const": "1.0.0"}, "scope": {"const": "fixture-only"},
        "identity": {"$ref": "#/$defs/identity"}, "attemptId": {"$ref": "#/$defs/id"},
        "fixtureId": {"$ref": "#/$defs/fixtureId"}, "inputText": {"type": "string", "maxLength": 16384},
        "limits": {"$ref": "#/$defs/limits"}
      }
    },
    "state": {"enum": ["reserved", "start-claimed", "started", "completed-for-review", "failed", "canceled", "timed-out", "indeterminate"]},
    "metrics": {
      "type": "object", "additionalProperties": false,
      "required": ["spawnAttempts", "mainStartsObserved", "stdoutBytes", "stderrBytes", "events", "elapsedMs", "terminationConfirmed"],
      "properties": {
        "spawnAttempts": {"type": "integer", "minimum": 0, "maximum": 1},
        "mainStartsObserved": {"type": "integer", "minimum": 0, "maximum": 1},
        "stdoutBytes": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
        "stderrBytes": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
        "events": {"type": "integer", "minimum": 0, "maximum": 513},
        "elapsedMs": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
        "terminationConfirmed": {"type": "boolean"}
      }
    },
    "reasons": {"type": "array", "maxItems": 32, "uniqueItems": true, "items": {"enum": ["byte-limit","duplicate-json-key","event-json-limit","invalid-byte-input","invalid-event-object","invalid-json","invalid-unicode","invalid-utf8","json-number-precision-loss","metadata-limit","non-finite-json-number","non-json-metadata","store-created-resource-unusable","store-directory-replaced","store-file-limit","store-invalid-parent","store-io-failed","store-residual-resource","store-resource-changed","store-resource-exists","store-resource-replaced","store-short-write","store-symlink-path","store-unsafe-resource","supervised-after-terminal","supervised-budget-consumed","supervised-budget-reserved","supervised-canceled","supervised-canceled-before-reservation","supervised-canceled-before-start","supervised-clock-unavailable","supervised-consumer-required","supervised-deadline","supervised-deadline-before-start","supervised-descendants-live","supervised-empty-reservation","supervised-event-binding-mismatch","supervised-event-chain-mismatch","supervised-event-gap","supervised-event-limit","supervised-exit-failed","supervised-fixture-completed","supervised-fixture-directory-unsafe","supervised-fixture-source-unsafe","supervised-forbidden-event","supervised-group-unconfirmed","supervised-incompatible-limits","supervised-incomplete-protocol","supervised-invalid-claim","supervised-invalid-completion","supervised-invalid-deadline","supervised-invalid-event","supervised-invalid-identity","supervised-invalid-observation","supervised-invalid-processReport","supervised-invalid-receipt","supervised-invalid-report","supervised-invalid-request","supervised-invalid-reservation","supervised-invalid-start","supervised-invalid-transition","supervised-line-limit","supervised-local-error","supervised-local-result","supervised-output-limit","supervised-platform-not-admitted","supervised-process-error","supervised-receipt-mismatch","supervised-reconciliation-required","supervised-reservation-changed","supervised-result-recorded","supervised-root-not-temporary","supervised-signal-unconfirmed","supervised-spawn-failed","supervised-start-record-unconfirmed","supervised-stderr-error","supervised-stderr-invalid-utf8","supervised-stderr-limit","supervised-stdin-error","supervised-stdout-error","supervised-unconfirmed-terminal","supervised-unterminated-line","supervised-workspace-cleanup-required","supervised-workspace-parent-unsafe","supervised-write-not-confirmed","synthetic-result","unsafe-json-key"]}},
    "receipt": {
      "type": "object", "additionalProperties": false,
      "required": ["schemaVersion", "scope", "terminalSha256"],
      "properties": {
        "schemaVersion": {"const": "1.0.0"}, "scope": {"const": "fixture-only"},
        "terminalSha256": {"$ref": "#/$defs/sha"}
      }
    },
    "event": {
      "type": "object", "additionalProperties": false,
      "required": ["schemaVersion", "scope", "sequence", "previousSha256", "identity", "attemptId", "fixtureId", "requestSha256", "limits", "state", "observedAt", "metrics", "reasons", "fixtureModelCalls", "actualModelCalls", "internalCallCeiling", "remoteCancellationVerified"],
      "properties": {
        "schemaVersion": {"const": "1.0.0"}, "scope": {"const": "fixture-only"},
        "sequence": {"type": "integer", "minimum": 0, "maximum": 3},
        "previousSha256": {"anyOf": [{"$ref": "#/$defs/sha"}, {"type": "null"}]},
        "identity": {"$ref": "#/$defs/identity"}, "attemptId": {"$ref": "#/$defs/id"},
        "fixtureId": {"$ref": "#/$defs/fixtureId"}, "requestSha256": {"$ref": "#/$defs/sha"},
        "limits": {"$ref": "#/$defs/limits"}, "state": {"$ref": "#/$defs/state"},
        "observedAt": {"type": "string", "format": "date-time"},
        "metrics": {"$ref": "#/$defs/metrics"}, "reasons": {"$ref": "#/$defs/reasons"},
        "fixtureModelCalls": {"const": 0}, "actualModelCalls": {"type": "null"},
        "internalCallCeiling": {"type": "null"}, "remoteCancellationVerified": {"const": false}
      }
    },
    "storageReport": {
      "type": "object", "additionalProperties": false,
      "required": ["state", "durability", "reasons"],
      "properties": {
        "state": {"enum": ["blocked", "recorded", "reconciliation-required"]},
        "durability": {"enum": ["confirmed", "unconfirmed"]}, "reasons": {"$ref": "#/$defs/reasons"}
      }
    },
    "report": {
      "type": "object", "additionalProperties": false,
      "required": ["scope", "state", "fixtureExecuted", "nativeExecuted", "runtimeReady", "verifiedAdmission", "actualModelCalls", "fixtureModelCalls", "internalCallCeiling", "remoteCancellationVerified", "process", "storage", "elapsedMs", "reasons"],
      "properties": {
        "scope": {"const": "fixture-only"},
        "state": {"enum": ["not-started", "completed-for-review", "failed", "canceled", "timed-out", "indeterminate"]},
        "fixtureExecuted": {"type": "boolean"}, "nativeExecuted": {"const": false},
        "runtimeReady": {"const": false}, "verifiedAdmission": {"const": false},
        "actualModelCalls": {"type": "null"}, "fixtureModelCalls": {"const": 0},
        "internalCallCeiling": {"type": "null"}, "remoteCancellationVerified": {"const": false},
        "process": {"anyOf": [{"$ref": "#/$defs/processReport"}, {"type": "null"}]},
        "storage": {"anyOf": [{"$ref": "#/$defs/storageReport"}, {"type": "null"}]},
        "elapsedMs": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
        "reasons": {"$ref": "#/$defs/reasons"}
      }
    },
    "observation": {
      "type": "object", "additionalProperties": false,
      "required": ["state", "budgetConsumed", "eventCount", "lastState", "spawnAttempts", "mainStartsObserved", "fixtureModelCalls", "actualModelCalls", "internalCallCeiling", "remoteCancellationVerified", "reasons"],
      "properties": {
        "state": {"enum": ["clear", "consumed", "reconciliation-required"]}, "budgetConsumed": {"type": "boolean"},
        "eventCount": {"type": "integer", "minimum": 0, "maximum": 4},
        "lastState": {"anyOf": [{"$ref": "#/$defs/state"}, {"type": "null"}]},
        "spawnAttempts": {"type": ["integer", "null"], "minimum": 0, "maximum": 1},
        "mainStartsObserved": {"type": ["integer", "null"], "minimum": 0, "maximum": 1},
        "fixtureModelCalls": {"const": 0}, "actualModelCalls": {"type": "null"},
        "internalCallCeiling": {"type": "null"}, "remoteCancellationVerified": {"const": false},
        "reasons": {"$ref": "#/$defs/reasons"}
      }
    },
    "processReport": {
      "type": "object", "additionalProperties": false,
      "required": ["scope", "state", "fixtureExecuted", "nativeExecuted", "runtimeReady", "verifiedAdmission", "actualModelCalls", "fixtureModelCalls", "internalCallCeiling", "remoteCancellationVerified", "metrics", "exitObserved", "pipesClosed", "groupObservation", "reasons"],
      "properties": {
        "scope": {"const": "fixture-only"},
        "state": {"enum": ["not-started", "completed-for-review", "failed", "canceled", "timed-out", "indeterminate"]},
        "fixtureExecuted": {"type": "boolean"}, "nativeExecuted": {"const": false},
        "runtimeReady": {"const": false}, "verifiedAdmission": {"const": false},
        "actualModelCalls": {"type": "null"}, "fixtureModelCalls": {"const": 0},
        "internalCallCeiling": {"type": "null"}, "remoteCancellationVerified": {"const": false},
        "metrics": {"$ref": "#/$defs/metrics"}, "exitObserved": {"type": "boolean"}, "pipesClosed": {"type": "boolean"},
        "groupObservation": {"enum": ["not-started", "absent", "unconfirmed"]}, "reasons": {"$ref": "#/$defs/reasons"}
      }
    }
  }
}
