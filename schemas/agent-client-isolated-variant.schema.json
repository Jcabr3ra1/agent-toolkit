{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-toolkit.local/schemas/agent-client-isolated-variant.schema.json",
  "$ref": "#/$defs/input",
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$" },
    "digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "time": { "type": "string", "format": "date-time" },
    "mechanismId": {
      "enum": ["tools-empty-denied", "restricted-settings", "local-personalizations-excluded", "session-hooks-disabled", "managed-sources-excluded", "strict-empty-mcp", "connectors-disabled", "browser-ide-excluded", "skills-plugins-delegation-excluded", "minimal-environment", "updates-nonessential-traffic-disabled", "resume-persistence-fallback-excluded"]
    },
    "candidate": {
      "type": "object", "additionalProperties": false,
      "required": ["client", "candidateId", "artifactSha256", "versionReference", "configurationSha256", "environmentSha256", "authentication"],
      "properties": {
        "client": { "const": "claude-code" },
        "candidateId": { "$ref": "#/$defs/id" },
        "artifactSha256": { "$ref": "#/$defs/digest" },
        "versionReference": { "$ref": "#/$defs/id" },
        "configurationSha256": { "$ref": "#/$defs/digest" },
        "environmentSha256": { "$ref": "#/$defs/digest" },
        "authentication": { "enum": ["subscription", "api", "bare", "unknown"] }
      }
    },
    "observation": {
      "type": "object", "additionalProperties": false,
      "required": ["mechanismId", "state", "referenceId", "observedAt"],
      "properties": {
        "mechanismId": { "$ref": "#/$defs/mechanismId" },
        "state": { "enum": ["configured", "absent", "unknown"] },
        "referenceId": { "$ref": "#/$defs/id" },
        "observedAt": { "$ref": "#/$defs/time" }
      }
    },
    "assessment": {
      "oneOf": [
        {
          "type": "object", "additionalProperties": false,
          "required": ["mechanismId", "provenance", "outcome"],
          "properties": {
            "mechanismId": { "$ref": "#/$defs/mechanismId" },
            "provenance": { "const": "pending" },
            "outcome": { "const": "unknown" }
          }
        },
        {
          "type": "object", "additionalProperties": false,
          "required": ["mechanismId", "provenance", "basis", "outcome", "referenceId", "observedAt", "scopeSha256", "definitionSha256"],
          "properties": {
            "mechanismId": { "$ref": "#/$defs/mechanismId" },
            "provenance": { "enum": ["documented", "local-structure-observation", "operator-attested", "native-variant-tested", "rejected"] },
            "basis": { "enum": ["documentation", "structure", "attestation", "native-test"] },
            "outcome": { "enum": ["supported", "unknown", "incompatible"] },
            "referenceId": { "$ref": "#/$defs/id" },
            "observedAt": { "$ref": "#/$defs/time" },
            "scopeSha256": { "$ref": "#/$defs/digest" },
            "definitionSha256": { "$ref": "#/$defs/digest" }
          }
        }
      ]
    },
    "input": {
      "type": "object", "additionalProperties": false,
      "required": ["schemaVersion", "variantId", "candidate", "now", "mode", "role", "mechanisms", "observations", "assessments"],
      "properties": {
        "schemaVersion": { "const": "1.0.0" },
        "variantId": { "const": "claude-subscription-text-v1" },
        "candidate": { "$ref": "#/$defs/candidate" },
        "now": { "$ref": "#/$defs/time" },
        "mode": { "enum": ["tutor", "autonomous"] },
        "role": { "enum": ["proponent", "reviewer"] },
        "mechanisms": { "type": "array", "maxItems": 12, "items": { "$ref": "#/$defs/mechanismId" } },
        "observations": { "type": "array", "maxItems": 12, "items": { "$ref": "#/$defs/observation" } },
        "assessments": { "type": "array", "maxItems": 12, "items": { "$ref": "#/$defs/assessment" } }
      }
    },
    "policy": {
      "type": "object", "additionalProperties": false,
      "required": ["policyId", "maxEvidenceAgeSeconds", "revokedReferences", "allowedVariants"],
      "properties": {
        "policyId": { "$ref": "#/$defs/id" },
        "maxEvidenceAgeSeconds": { "type": "integer", "minimum": 1, "maximum": 3600 },
        "revokedReferences": { "type": "array", "maxItems": 256, "uniqueItems": true, "items": { "$ref": "#/$defs/id" } },
        "allowedVariants": { "type": "array", "maxItems": 1, "uniqueItems": true, "items": { "const": "claude-subscription-text-v1" } }
      }
    },
    "report": {
      "type": "object", "additionalProperties": false,
      "required": ["scope", "state", "reasons", "unresolvedMechanisms", "descriptionSha256", "scopeSha256", "executed", "runtimeReady", "verifiedAdmission", "externalBillingVerified", "effectiveIsolationVerified"],
      "properties": {
        "scope": { "const": "isolated-variant-claims-only" },
        "state": { "enum": ["invalid", "incomplete", "blocked", "ready-for-variant-review"] },
        "reasons": { "type": "array", "minItems": 1, "maxItems": 32, "uniqueItems": true, "items": { "$ref": "#/$defs/id" } },
        "unresolvedMechanisms": { "type": "array", "maxItems": 12, "uniqueItems": true, "items": { "$ref": "#/$defs/mechanismId" } },
        "descriptionSha256": { "anyOf": [{ "type": "null" }, { "$ref": "#/$defs/digest" }] },
        "scopeSha256": { "anyOf": [{ "type": "null" }, { "$ref": "#/$defs/digest" }] },
        "executed": { "const": false },
        "runtimeReady": { "const": false },
        "verifiedAdmission": { "const": false },
        "externalBillingVerified": { "const": false },
        "effectiveIsolationVerified": { "const": false }
      }
    }
  }
}
